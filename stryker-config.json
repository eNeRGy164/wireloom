{
  "stryker-config": {
    "solution": "Wireloom.slnx",
    "mutate": [
      "src/Wireloom.Dds.CSharp.Compiler/**/*.cs",
      "src/Wireloom.Dds.CSharp.Generator/**/*.cs",
      "src/Wireloom.Dds.Idl/**/*.cs",
      "src/Wireloom.Dds.Cpp.Compiler/**/*.cs",
      "src/Wireloom.Dds.Cpp.Generator/**/*.cs"
    ],
    "test-runner": "mtp",
    "additional-timeout": 2000,
    "timeout-ratio": 1.05,
    "reporters": [ "html", "json", "markdown", "progress" ],
    "report-file-name": "mutation-report",
    "thresholds": {
      "high": 0,
      "low": 0,
      "break": 0
    }
  }
}
