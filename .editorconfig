root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.feature]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{csproj,xml,runsettings,props,config}]
indent_size = 2
tab_width = 2
charset = utf-8

[*.{cs,csx,vb,vbx}]
indent_size = 4
tab_width = 4
charset = utf-8
