# Normalize text files and keep LF in the repository
* text=auto eol=lf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.ico binary

# Captured release evidence must retain its original bytes and recorded hashes.
docs/releases/evidence/** -text -whitespace
docs/testing/wire-compatibility/evidence/** -text -whitespace
