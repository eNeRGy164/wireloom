<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Wireloom.Dds.CSharp.Compiler.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Wireloom.Dds.CSharp.Compiler/Wireloom.Dds.CSharp.Compiler.csproj" />
    <ProjectReference Include="../../src/Wireloom.Dds.Cpp.Compiler/Wireloom.Dds.Cpp.Compiler.csproj" />
    <ProjectReference Include="../../src/Wireloom.Dds.Idl/Wireloom.Dds.Idl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Wireloom.Dds.Cpp" />
    <Using Include="Wireloom.Dds.CSharp.Compiler" />
    <Using Include="Wireloom.Dds.Idl" />
    <Using Include="Wireloom.Dds.Idl.Compiler.FrontEnd" />
    <Using Include="Wireloom.Dds.Idl.Compiler.FrontEnd.Parsing" />
    <Using Include="Wireloom.Dds.Idl.Compiler.FrontEnd.Preprocessing" />
    <Using Include="Wireloom.Dds.Idl.Compiler.FrontEnd.Semantic" />
    <Using Include="Wireloom.Dds.Idl.Compiler.FrontEnd.Symbols" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/CompilerTestSupport.cs" Link="Support/CompilerTestSupport.cs" />
    <Compile Include="../../src/Wireloom.Playground.Browser/PlaygroundCompilerAdapter.cs" Link="Playground/PlaygroundCompilerAdapter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="Rti.ConnextDds" Version="[$(Rti612CompatibilityVersion)];[$(Rti731CompatibilityVersion)];[$(Rti770CompatibilityVersion)]" />
    <None Include="$(NuGetPackageRoot)/rti.connextdds/$(Rti612CompatibilityVersion)/lib/netstandard2.0/Rti.ConnextDds.dll"
          Link="RuntimeReferences/6.1.2/Rti.ConnextDds.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)/rti.connextdds/$(Rti731CompatibilityVersion)/lib/netstandard2.0/Rti.ConnextDds.dll"
          Link="RuntimeReferences/7.3.1/Rti.ConnextDds.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)/rti.connextdds/$(Rti770CompatibilityVersion)/lib/netstandard2.0/Rti.ConnextDds.dll"
          Link="RuntimeReferences/7.7.0/Rti.ConnextDds.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../playground/src/protocol.ts" Link="Playground/protocol.ts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
