if(NOT EXISTS "${RTI_STATUS}" OR NOT EXISTS "${WIRELOOM_STATUS}")
    message(FATAL_ERROR "Both RTI and Wireloom boundary outcomes must exist")
endif()
file(READ "${RTI_STATUS}" rti_result)
file(READ "${WIRELOOM_STATUS}" wireloom_result)
string(STRIP "${rti_result}" rti_result)
string(STRIP "${wireloom_result}" wireloom_result)
if(rti_result STREQUAL "accepted")
    set(rti_classification accepted)
elseif(rti_result MATCHES "^rejected:")
    set(rti_classification rejected)
else()
    message(FATAL_ERROR "Unrecognized RTI boundary outcome '${rti_result}'")
endif()
if(wireloom_result STREQUAL "accepted")
    set(wireloom_classification accepted)
elseif(wireloom_result MATCHES "^rejected:")
    set(wireloom_classification rejected)
else()
    message(FATAL_ERROR "Unrecognized Wireloom boundary outcome '${wireloom_result}'")
endif()
if(NOT rti_classification STREQUAL wireloom_classification)
    message(FATAL_ERROR "RTI and Wireloom boundary classifications differ ('${rti_classification}' != '${wireloom_classification}')")
endif()
message(STATUS "RTI and Wireloom boundary classifications match: ${rti_classification}")
