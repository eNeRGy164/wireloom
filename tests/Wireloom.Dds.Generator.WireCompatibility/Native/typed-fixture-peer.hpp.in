                    const auto &actual = sample.data();
                    if (WIRELOOM_TYPED_MEMBER(actual, narrowValues).has_value()
                        != WIRELOOM_TYPED_MEMBER(expected, narrowValues).has_value()) {
                        sample_matches = false;
                        optional_mismatch = "narrowValues presence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, narrowValues).has_value()
                        && *WIRELOOM_TYPED_MEMBER(actual, narrowValues)
                            != *WIRELOOM_TYPED_MEMBER(expected, narrowValues)) {
                        sample_matches = false;
                        optional_mismatch = "narrowValues sequence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, wideValues).has_value()
                        != WIRELOOM_TYPED_MEMBER(expected, wideValues).has_value()) {
                        sample_matches = false;
                        optional_mismatch = "wideValues presence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, wideValues).has_value()
                        && *WIRELOOM_TYPED_MEMBER(actual, wideValues)
                            != *WIRELOOM_TYPED_MEMBER(expected, wideValues)) {
                        sample_matches = false;
                        optional_mismatch = "wideValues sequence differs";
                    }
                }
#endif
                if (!sample_matches) {
                    const auto match_status = reader.subscription_matched_status();
                    std::cout << "READER_STATS case=" << case_id
                              << " matched_writers_current=" << match_status.current_count()
                              << " matched_writers_total=" << match_status.total_count()
                              << " take_calls=" << take_calls
                              << " returned_samples=" << returned_samples
                              << " valid_samples=" << valid_samples
                              << " invalid_samples=" << invalid_samples << std::endl;
                    std::ostringstream expected_text;
                    std::ostringstream actual_text;
                    expected_text << expected;
                    actual_text << sample.data();
                    std::cout << "EXPECTED_SAMPLE " << expected_text.str() << std::endl;
                    std::cout << "ACTUAL_SAMPLE " << actual_text.str() << std::endl;
                    throw std::runtime_error(
                        "Received sample differs from " + case_id + " fixture " + fixture
                        + (optional_mismatch.empty() ? "" : ": " + optional_mismatch));
                }
                const auto match_status = reader.subscription_matched_status();
                std::cout << "READER_STATS case=" << case_id
                          << " matched_writers_current=" << match_status.current_count()
                          << " matched_writers_total=" << match_status.total_count()
                          << " take_calls=" << take_calls
                          << " returned_samples=" << returned_samples
                          << " valid_samples=" << valid_samples
                          << " invalid_samples=" << invalid_samples << std::endl;
                std::cout << "RECEIVED" << std::endl;
                return 0;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(50));
        }
        const auto match_status = reader.subscription_matched_status();
        std::cout << "READER_STATS case=" << case_id
                  << " matched_writers_current=" << match_status.current_count()
                  << " matched_writers_total=" << match_status.total_count()
                  << " take_calls=" << take_calls
                  << " returned_samples=" << returned_samples
                  << " valid_samples=" << valid_samples
                  << " invalid_samples=" << invalid_samples << std::endl;
        throw std::runtime_error(
            "No sample received for " + case_id + " fixture " + fixture);
    }

    throw std::invalid_argument("role must be writer or reader");
}
#endif
