                                  << " serialized_bytes=" << serialized_size
                                  << " valid_samples=" << valid_samples
                                  << " invalid_samples=" << invalid_samples
                                  << " writer_guid=" << writer_guid
                                  << " sequence=" << sequence_number
                                  << " received_fragments_delta=" << received_fragments
                                  << " reassembled_samples_delta=" << reassembled_samples
                                  << " dropped_fragments_delta=" << dropped_fragments
                                  << " rejected_samples_delta=" << rejected_samples << std::endl;
                        total_valid_samples += valid_samples;
                        previous_protocol_status = protocol_status;
                        std::cout << "PHASE_VERIFIED " << topic_name << " " << phase << std::endl;
                        verified = true;
                    } else {
                        std::this_thread::sleep_for(std::chrono::milliseconds(10));
                    }
                }
                if (!verified) {
                    throw std::runtime_error("Timed out waiting for lifecycle phase " + std::to_string(phase));
                }
