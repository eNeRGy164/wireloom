                          << limits.initial_fragmented_samples() << " max_fragmented_samples="
                          << limits.max_fragmented_samples() << " max_fragmented_samples_per_remote_writer="
                          << limits.max_fragmented_samples_per_remote_writer() << " max_fragments_per_sample="
                          << limits.max_fragments_per_sample() << " history_kind=KEEP_LAST history_depth="
                          << history.depth() << std::endl;
            }
