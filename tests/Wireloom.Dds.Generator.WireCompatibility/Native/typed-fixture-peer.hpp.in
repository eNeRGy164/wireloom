            std::cout << "LIFECYCLE_RECEIVE_STORAGE implementation=rti-cpp phases=5 history_depth=1 optional_nested_transitions=true loan_returned_before_ack=true content_verified=true" << std::endl;
            std::cout << "LIFECYCLE_READER_FINAL valid_samples=" << total_valid_samples
                      << " rejected_samples=" << final_protocol_status.rejected_sample_count().total()
