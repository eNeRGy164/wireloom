#pragma once
#include "peer-qos.hpp"
#include <sstream>
#include <utility>
#ifdef WIRELOOM_RTI_7_3_1
#define WIRELOOM_SET_TYPED_STRING(member, value) expected.member(value)
#define WIRELOOM_SET_TYPED_MEMBER(member, value) expected.member(value)
#define WIRELOOM_SET_TYPED_MEMBER_ON(object, member, value) object.member(value)
#define WIRELOOM_TYPED_MEMBER(object, member) object.member()
#define WIRELOOM_SET_MEMBER_ON(object, member, value) object.member(value)
#define WIRELOOM_BOUNDED_SEQUENCE ::rti::core::bounded_sequence
#else
#define WIRELOOM_SET_TYPED_STRING(member, value) expected.member = value
#define WIRELOOM_SET_TYPED_MEMBER(member, value) expected.member = value
#define WIRELOOM_SET_TYPED_MEMBER_ON(object, member, value) object.member = value
#define WIRELOOM_TYPED_MEMBER(object, member) object.member
#define WIRELOOM_SET_MEMBER_ON(object, member, value) object.member = value
#define WIRELOOM_BOUNDED_SEQUENCE ::omg::types::bounded_sequence
#endif
#if defined(WIRELOOM_TYPED_STRING_SEQUENCE_FIXTURE) || defined(WIRELOOM_TYPED_WIDE_STRINGS_FIXTURE) || defined(WIRELOOM_TYPED_STRING_BOUNDARIES_FIXTURE) || defined(WIRELOOM_TYPED_OPTIONAL_AGGREGATE_FIXTURE) || defined(WIRELOOM_TYPED_OPTIONAL_RECURSIVE_ARRAY_FIXTURE) || defined(WIRELOOM_TYPED_UNBOUNDED_STRING_ALIASES) || defined(WIRELOOM_TYPED_RESOLVE_NAME_WSTRING_ALIASES) || defined(WIRELOOM_TYPED_NUMERIC_CHAR_UNION) || defined(WIRELOOM_TYPED_STRING_ALIAS_CHAINS) || defined(WIRELOOM_TYPED_UNBOUNDED_SEQUENCE_ALIASES) || defined(WIRELOOM_TYPED_UNION_STRING_SEQUENCE_ALIASES) || defined(WIRELOOM_TYPED_UNION_STRING_SEQUENCE_BOUNDED)
// RTI's generated DynamicData API omits some string template instantiations.
// Use RTI-generated typed C++ endpoints for these fixtures and compare the
// complete generated sample value at the reader.
static int run_typed_fixture_peer(
    dds::domain::DomainParticipant &participant,
    const std::string &role,
    const std::string &topic_name,
    int timeout_seconds,
    const std::string &case_id,
    const std::string &fixture)
{
    DdsType expected;
#ifdef WIRELOOM_TYPED_UNBOUNDED_SEQUENCE_ALIASES
    if (case_id == "05-unbounded-sequence-aliases" && fixture == "sequence-multiple") {
        ::CorpusUnboundedSequences::Numbers numbers;
        numbers.push_back(101);
        numbers.push_back(-102);
        WIRELOOM_SET_TYPED_MEMBER(numbers, std::move(numbers));
        ::CorpusUnboundedSequences::States states;
        states.push_back(::CorpusUnboundedSequences::State::Idle);
        states.push_back(::CorpusUnboundedSequences::State::Ready);
        WIRELOOM_SET_TYPED_MEMBER(states, std::move(states));
        ::CorpusUnboundedSequences::Children children;
        ::CorpusUnboundedSequences::Child first_child;
        WIRELOOM_SET_TYPED_MEMBER_ON(first_child, value, 301);
        ::CorpusUnboundedSequences::Child second_child;
        WIRELOOM_SET_TYPED_MEMBER_ON(second_child, value, -302);
        children.push_back(first_child);
        children.push_back(second_child);
        WIRELOOM_SET_TYPED_MEMBER(children, std::move(children));
        ::CorpusUnboundedSequences::Scalars scalars;
        scalars.push_back(201);
        scalars.push_back(-202);
        WIRELOOM_SET_TYPED_MEMBER(scalars, std::move(scalars));
        ::CorpusUnboundedSequences::Texts texts;
        texts.push_back("narrow-1");
        texts.push_back("narrow-2");
        WIRELOOM_SET_TYPED_MEMBER(texts, std::move(texts));
        ::CorpusUnboundedSequences::WideTexts wide_texts;
        wide_texts.push_back(L"wide-λ");
        wide_texts.push_back(L"wide-2");
        WIRELOOM_SET_TYPED_MEMBER(wideTexts, std::move(wide_texts));
        ::CorpusUnboundedSequences::BoundedTexts bounded_texts;
        bounded_texts.push_back("12345678");
        bounded_texts.push_back("bounded");
        WIRELOOM_SET_TYPED_MEMBER(boundedTexts, std::move(bounded_texts));
        ::CorpusUnboundedSequences::BoundedWideTexts bounded_wide_texts;
        bounded_wide_texts.push_back(L"ABCD");
        bounded_wide_texts.push_back(L"wide");
        WIRELOOM_SET_TYPED_MEMBER(boundedWideTexts, std::move(bounded_wide_texts));
    }
#endif
#ifdef WIRELOOM_TYPED_UNION_STRING_SEQUENCE_ALIASES
    if (case_id == "07-union-string-sequence-aliases") {
        const bool wide = fixture == "union-direct-wide" || fixture == "union-alias-wide"
            || fixture == "union-bounded-wide";
        const bool bounded = fixture.find("bounded") != std::string::npos;
        ::RuntimeUnionStringSequences::DirectStringSequences direct;
        ::RuntimeUnionStringSequences::StringSequenceAliases aliases;
        if (fixture.find("direct") != std::string::npos) {
            if (wide) {
                WIRELOOM_BOUNDED_SEQUENCE<std::wstring, 3> values;
                values.push_back(L"wide-λ");
                values.push_back(L"wide-2");
                values.push_back(L"wide-3");
                direct.wide(std::move(values));
            } else {
                WIRELOOM_BOUNDED_SEQUENCE<std::string, 3> values;
                values.push_back("narrow-1");
                values.push_back("narrow-2");
                values.push_back("narrow-3");
                direct.narrow(std::move(values));
            }
            WIRELOOM_SET_TYPED_MEMBER(direct, std::move(direct));
        } else if (bounded && wide) {
            ::RuntimeUnionStringSequences::BoundedWideTexts values;
            values.push_back(L"ABCD");
            values.push_back(L"wide");
            values.push_back(L"LAST");
            aliases.boundedWide(std::move(values));
            WIRELOOM_SET_TYPED_MEMBER(aliases, std::move(aliases));
        } else if (bounded) {
            ::RuntimeUnionStringSequences::BoundedNarrowTexts values;
            values.push_back("12345678");
            values.push_back("bounded");
            values.push_back("ABCDEFGH");
            aliases.boundedNarrow(std::move(values));
            WIRELOOM_SET_TYPED_MEMBER(aliases, std::move(aliases));
        } else if (wide) {
            ::RuntimeUnionStringSequences::WideTexts values;
            values.push_back(L"wide-λ");
            values.push_back(L"wide-2");
            values.push_back(L"wide-3");
            aliases.wide(std::move(values));
            WIRELOOM_SET_TYPED_MEMBER(aliases, std::move(aliases));
        } else {
            ::RuntimeUnionStringSequences::NarrowTexts values;
            values.push_back("narrow-1");
            values.push_back("narrow-2");
            values.push_back("narrow-3");
            aliases.narrow(std::move(values));
            WIRELOOM_SET_TYPED_MEMBER(aliases, std::move(aliases));
        }
    }
#endif
#ifdef WIRELOOM_TYPED_UNION_STRING_SEQUENCE_BOUNDED
    if (case_id == "07-union-string-sequence-bounded-direct") {
        const bool wide = fixture.find("wide") != std::string::npos;
        const bool multiple = fixture.find("multiple") != std::string::npos;
        if (wide) {
            WIRELOOM_BOUNDED_SEQUENCE<std::wstring, 3> values;
            if (multiple) {
                values.push_back(L"ABCD");
                values.push_back(L"WIDE");
                values.push_back(L"LAST");
            }
            expected.wide(std::move(values));
        } else {
            WIRELOOM_BOUNDED_SEQUENCE<std::string, 3> values;
            if (multiple) {
                values.push_back("12345678");
                values.push_back("87654321");
                values.push_back("ABCDEFGH");
            }
            expected.narrow(std::move(values));
        }
    }
#endif
#ifdef WIRELOOM_TYPED_STRING_SEQUENCE_FIXTURE
    if (case_id == "09-optional-string-sequences" && fixture != "optional-absent") {
        WIRELOOM_BOUNDED_SEQUENCE<std::string, 4> narrow_values;
        WIRELOOM_BOUNDED_SEQUENCE<std::wstring, 4> wide_values;
        if (fixture == "optional-empty" || fixture == "optional-multiple"
            || fixture == "optional-narrow-only") {
            if (fixture == "optional-multiple") {
                narrow_values.push_back("narrow-one");
                narrow_values.push_back("narrow-two");
                narrow_values.push_back("narrow-three");
            } else if (fixture == "optional-narrow-only") {
                narrow_values.push_back("narrow-only");
            }
            WIRELOOM_SET_MEMBER_ON(expected, narrowValues, std::move(narrow_values));
        }
        if (fixture == "optional-empty" || fixture == "optional-multiple"
            || fixture == "optional-wide-only") {
            if (fixture == "optional-multiple") {
                wide_values.push_back(L"wide-one");
                wide_values.push_back(L"wide-two");
            } else if (fixture == "optional-wide-only") {
                wide_values.push_back(L"wide-only");
            }
            WIRELOOM_SET_MEMBER_ON(expected, wideValues, std::move(wide_values));
        }
    }
#endif
#ifdef WIRELOOM_TYPED_UNBOUNDED_STRING_ALIASES
    if (case_id == "04-unbounded-string-aliases") {
        WIRELOOM_SET_TYPED_STRING(narrow, fixture == "string-empty" ? "" : std::string(255, 'n'));
        WIRELOOM_SET_TYPED_STRING(wide, fixture == "string-empty" ? L"" : std::wstring(255, L'λ'));
    }
#endif
#ifdef WIRELOOM_TYPED_NUMERIC_CHAR_UNION
    if (case_id == "07-union-char-numeric" || case_id == "07-union-char-numeric-255") {
        if (fixture == "union-127") {
            expected.value(13701);
        } else if (fixture == "union-255") {
            expected.value(13702);
        } else if (fixture == "union-default") {
            expected.fallback(13703);
            expected._d(static_cast<char>(65));
        } else {
            throw std::runtime_error("Unknown numeric character union fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_STRING_ALIAS_CHAINS
    if (case_id == "04-string-alias-chains") {
        const bool empty = fixture == "string-empty";
        const std::string narrow = empty ? "" : "1234567890123456";
        const std::wstring wide = empty ? L"" : L"12345678";
        WIRELOOM_SET_TYPED_STRING(narrow, narrow);
        WIRELOOM_SET_TYPED_STRING(narrowChain, narrow);
        WIRELOOM_SET_TYPED_STRING(boundedNarrow, narrow);
        WIRELOOM_SET_TYPED_STRING(boundedNarrowChain, narrow);
        WIRELOOM_SET_TYPED_STRING(boundedNarrowChain2, narrow);
        WIRELOOM_SET_TYPED_STRING(wide, wide);
        WIRELOOM_SET_TYPED_STRING(wideChain, wide);
        WIRELOOM_SET_TYPED_STRING(boundedWide, wide);
        WIRELOOM_SET_TYPED_STRING(boundedWideChain, wide);
        WIRELOOM_SET_TYPED_STRING(boundedWideChain2, wide);
    }
#endif
#ifdef WIRELOOM_TYPED_RESOLVE_NAME_WSTRING_ALIASES
    if (case_id == "10-resolve-name-wstring-aliases") {
        const bool empty = fixture == "string-empty";
        if (!empty && fixture != "string-boundary") {
            throw std::runtime_error("Unknown wstring alias fixture: " + fixture);
        }
        WIRELOOM_SET_TYPED_STRING(firstLevel, empty ? L"" : L"12345678");
        WIRELOOM_SET_TYPED_STRING(secondLevel, empty ? L"" : L"ABCDEFGH");
    }
#endif
#ifdef WIRELOOM_TYPED_WIDE_STRINGS_FIXTURE
    if (case_id == "04-strings") {
        if (fixture == "string-empty") {
            WIRELOOM_SET_TYPED_STRING(unbounded, "");
            WIRELOOM_SET_TYPED_STRING(bounded, "");
            WIRELOOM_SET_TYPED_STRING(wideUnbounded, L"");
            WIRELOOM_SET_TYPED_STRING(wideBounded, L"");
        } else if (fixture == "string-boundary") {
            WIRELOOM_SET_TYPED_STRING(unbounded, "unbounded-boundary");
            WIRELOOM_SET_TYPED_STRING(bounded, "12345678");
            WIRELOOM_SET_TYPED_STRING(wideUnbounded, L"wide-boundary");
            WIRELOOM_SET_TYPED_STRING(wideBounded, L"ABCDEFGH");
        } else {
            WIRELOOM_SET_TYPED_STRING(unbounded, "narrow-unbounded");
            WIRELOOM_SET_TYPED_STRING(bounded, "bound801");
            WIRELOOM_SET_TYPED_STRING(wideUnbounded, L"wide-unbounded");
            WIRELOOM_SET_TYPED_STRING(wideBounded, L"wide801");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_STRING_BOUNDARIES_FIXTURE
    if (case_id == "04-boundaries") {
        WIRELOOM_SET_TYPED_STRING(narrow, fixture == "string-boundary" ? "12345678" : "edge-8");
        WIRELOOM_SET_TYPED_STRING(wide, fixture == "string-boundary" ? L"ABCDEFGH" : L"wide-8");
    }
#endif
#ifdef WIRELOOM_TYPED_OPTIONAL_AGGREGATE_FIXTURE
    if (case_id == "09-optional-aggregate-member" && fixture == "optional-present") {
        ::CorpusOptionalAggregate::Payload payload(9701);
        ::CorpusOptionalAggregate::Payload payload_alias(9703);
        ::CorpusOptionalAggregate::Payload choice_payload(9702);
        ::CorpusOptionalAggregate::Payload choice_alias_payload(9704);
        ::CorpusOptionalAggregate::Choice choice;
        ::CorpusOptionalAggregate::Choice choice_alias;
        choice.payload(std::move(choice_payload));
        choice_alias.payload(std::move(choice_alias_payload));
        WIRELOOM_SET_TYPED_MEMBER(payload, std::move(payload));
        WIRELOOM_SET_TYPED_MEMBER(payloadAlias, std::move(payload_alias));
        WIRELOOM_SET_TYPED_MEMBER(choice, std::move(choice));
        WIRELOOM_SET_TYPED_MEMBER(choiceAlias, std::move(choice_alias));
    }
#endif

#ifdef WIRELOOM_TYPED_OPTIONAL_RECURSIVE_ARRAY_FIXTURE
    if (fixture != "optional-absent" && fixture != "optional-present" && fixture != "optional-nested") {
        throw std::runtime_error("Unknown optional recursive array fixture: " + fixture);
    }
    WIRELOOM_SET_TYPED_MEMBER(value, 9801);
    if (fixture != "optional-absent") {
        ::dds::core::array<DdsType, 2> children;
        WIRELOOM_SET_TYPED_MEMBER_ON(children[0], value, 9811);
        WIRELOOM_SET_TYPED_MEMBER_ON(children[1], value, 9812);
        if (fixture == "optional-nested") {
            ::dds::core::array<DdsType, 2> grandchildren;
            WIRELOOM_SET_TYPED_MEMBER_ON(grandchildren[0], value, 9821);
            WIRELOOM_SET_TYPED_MEMBER_ON(grandchildren[1], value, 9822);
#ifdef WIRELOOM_RTI_7_3_1
            children[0].children(::dds::core::optional<::dds::core::array<DdsType, 2>>(
                std::move(grandchildren)));
#else
            children[0].children = std::move(grandchildren);
#endif
        }
#ifdef WIRELOOM_RTI_7_3_1
        expected.children(::dds::core::optional<::dds::core::array<DdsType, 2>>(std::move(children)));
#else
        expected.children = std::move(children);
#endif
    }
#endif

    dds::topic::Topic<DdsType> topic(participant, topic_name);
    if (role == "writer") {
        dds::pub::Publisher publisher(participant);
        auto writer_qos = reliable_writer_qos(publisher);
        if (case_id == "09-optional-recursive-array") {
            // Avoid allocating the recursive maximum size for every initial sample.
            // Samples larger than the fast-pool threshold can allocate separately.
            writer_qos.policy<rti::core::policy::Property>().set({
                "dds.data_writer.history.memory_manager.fast_pool.pool_buffer_max_size",
                "4096"});
        }

        dds::pub::DataWriter<DdsType> writer(publisher, topic, writer_qos);
        const auto deadline = std::chrono::steady_clock::now()
            + std::chrono::seconds(timeout_seconds);
        while (writer.publication_matched_status().current_count() == 0
            && std::chrono::steady_clock::now() < deadline) {
            std::this_thread::sleep_for(std::chrono::milliseconds(50));
        }
        if (writer.publication_matched_status().current_count() == 0) {
            throw std::runtime_error(
                "No reader discovered for " + case_id + " fixture " + fixture);
        }
        const auto matched_status = writer.publication_matched_status();
        std::cout << "WRITER_MATCHED case=" << case_id
                  << " fixture=" << fixture
                  << " readers_current=" << matched_status.current_count()
                  << " readers_total=" << matched_status.total_count() << std::endl;
#ifdef WIRELOOM_TYPED_STRING_SEQUENCE_FIXTURE
        if (case_id == "09-optional-string-sequences") {
            // Report optional presence separately from sequence length: an
            // absent member and a present empty sequence are distinct values.
            std::cout << "OPTIONAL_FIXTURE narrow_present="
                      << WIRELOOM_TYPED_MEMBER(expected, narrowValues).has_value()
                      << " narrow_length=" << (WIRELOOM_TYPED_MEMBER(expected, narrowValues).has_value()
                            ? WIRELOOM_TYPED_MEMBER(expected, narrowValues)->size() : 0)
                      << " wide_present=" << WIRELOOM_TYPED_MEMBER(expected, wideValues).has_value()
                      << " wide_length=" << (WIRELOOM_TYPED_MEMBER(expected, wideValues).has_value()
                            ? WIRELOOM_TYPED_MEMBER(expected, wideValues)->size() : 0) << std::endl;
        }
#endif
        writer.write(expected);
        writer.wait_for_acknowledgments(dds::core::Duration(timeout_seconds, 0));
        std::cout << "SENT" << std::endl;
        return 0;
    }

    if (role == "reader") {
        dds::sub::Subscriber subscriber(participant);
        auto reader_qos = subscriber.default_datareader_qos();
        reader_qos << dds::core::policy::Reliability(
            dds::core::policy::ReliabilityKind::RELIABLE);
        dds::sub::DataReader<DdsType> reader(subscriber, topic, reader_qos);
        const auto initial_match_status = reader.subscription_matched_status();
        std::cout << "READY case=" << case_id << " fixture=" << fixture
                  << " role=reader matched_writers_current="
                  << initial_match_status.current_count()
                  << " matched_writers_total=" << initial_match_status.total_count()
                  << " take_calls=0 returned_samples=0 valid_samples=0 invalid_samples=0"
                  << std::endl;
        const auto deadline = std::chrono::steady_clock::now()
            + std::chrono::seconds(timeout_seconds);
        uint64_t take_calls = 0;
        uint64_t returned_samples = 0;
        uint64_t valid_samples = 0;
        uint64_t invalid_samples = 0;
        while (std::chrono::steady_clock::now() < deadline) {
            auto samples = reader.take();
            ++take_calls;
            for (const auto &sample : samples) {
                ++returned_samples;
                if (sample.info().valid()) {
                    ++valid_samples;
                } else {
                    ++invalid_samples;
                }
            }

            for (const auto &sample : samples) {
                if (!sample.info().valid()) {
                    continue;
                }

                bool sample_matches = sample.data() == expected;
                std::string optional_mismatch;
#ifdef WIRELOOM_TYPED_NUMERIC_CHAR_UNION
                if (case_id == "07-union-char-numeric" || case_id == "07-union-char-numeric-255") {
                    const auto &actual = sample.data();
                    const auto discriminator = static_cast<unsigned char>(actual._d());
                    if (fixture == "union-default") {
                        sample_matches = discriminator == 65 && actual.fallback() == 13703;
                    } else if (fixture == "union-127") {
                        sample_matches = discriminator == 127 && actual.value() == 13701;
                    } else if (fixture == "union-255") {
                        sample_matches = discriminator == 255 && actual.value() == 13702;
                    }
                }
#endif
#ifdef WIRELOOM_TYPED_STRING_SEQUENCE_FIXTURE
                if (case_id == "09-optional-string-sequences") {
                    // Check both presence and content explicitly. Whole-sample
                    // equality alone can obscure whether absence, emptiness,
                    // or the actual string values caused a fixture failure.
                    const auto &actual = sample.data();
                    if (WIRELOOM_TYPED_MEMBER(actual, narrowValues).has_value()
                        != WIRELOOM_TYPED_MEMBER(expected, narrowValues).has_value()) {
                        sample_matches = false;
                        optional_mismatch = "narrowValues presence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, narrowValues).has_value()
                        && *WIRELOOM_TYPED_MEMBER(actual, narrowValues)
                            != *WIRELOOM_TYPED_MEMBER(expected, narrowValues)) {
                        sample_matches = false;
                        optional_mismatch = "narrowValues sequence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, wideValues).has_value()
                        != WIRELOOM_TYPED_MEMBER(expected, wideValues).has_value()) {
                        sample_matches = false;
                        optional_mismatch = "wideValues presence differs";
                    } else if (WIRELOOM_TYPED_MEMBER(actual, wideValues).has_value()
                        && *WIRELOOM_TYPED_MEMBER(actual, wideValues)
                            != *WIRELOOM_TYPED_MEMBER(expected, wideValues)) {
                        sample_matches = false;
                        optional_mismatch = "wideValues sequence differs";
                    }
                }
#endif
                if (!sample_matches) {
                    const auto match_status = reader.subscription_matched_status();
                    std::cout << "READER_STATS case=" << case_id
                              << " matched_writers_current=" << match_status.current_count()
                              << " matched_writers_total=" << match_status.total_count()
                              << " take_calls=" << take_calls
                              << " returned_samples=" << returned_samples
                              << " valid_samples=" << valid_samples
                              << " invalid_samples=" << invalid_samples << std::endl;
                    std::ostringstream expected_text;
                    std::ostringstream actual_text;
                    expected_text << expected;
                    actual_text << sample.data();
                    std::cout << "EXPECTED_SAMPLE " << expected_text.str() << std::endl;
                    std::cout << "ACTUAL_SAMPLE " << actual_text.str() << std::endl;
                    throw std::runtime_error(
                        "Received sample differs from " + case_id + " fixture " + fixture
                        + (optional_mismatch.empty() ? "" : ": " + optional_mismatch));
                }
                const auto match_status = reader.subscription_matched_status();
                std::cout << "READER_STATS case=" << case_id
                          << " matched_writers_current=" << match_status.current_count()
                          << " matched_writers_total=" << match_status.total_count()
                          << " take_calls=" << take_calls
                          << " returned_samples=" << returned_samples
                          << " valid_samples=" << valid_samples
                          << " invalid_samples=" << invalid_samples << std::endl;
                std::cout << "RECEIVED" << std::endl;
                return 0;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(50));
        }
        const auto match_status = reader.subscription_matched_status();
        std::cout << "READER_STATS case=" << case_id
                  << " matched_writers_current=" << match_status.current_count()
                  << " matched_writers_total=" << match_status.total_count()
                  << " take_calls=" << take_calls
                  << " returned_samples=" << returned_samples
                  << " valid_samples=" << valid_samples
                  << " invalid_samples=" << invalid_samples << std::endl;
        throw std::runtime_error(
            "No sample received for " + case_id + " fixture " + fixture);
    }

    throw std::invalid_argument("role must be writer or reader");
}
#endif
