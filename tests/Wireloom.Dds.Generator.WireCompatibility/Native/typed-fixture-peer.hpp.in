                const auto deadline = std::chrono::steady_clock::now()
                    + std::chrono::seconds(timeout_seconds);
                bool verified = false;
                while (!verified && std::chrono::steady_clock::now() < deadline) {
                    bool received = false;
                    int valid_samples = 0;
                    int invalid_samples = 0;
                    std::string writer_guid;
                    std::string sequence_number;
                    {
                        auto samples = reader.take();
                        for (const auto &sample : samples) {
                            if (!sample.info().valid()) {
                                ++invalid_samples;
                                continue;
                            }
                            ++valid_samples;
                            if (!(sample.data() == expected)) {
                                throw std::runtime_error("Lifecycle sample differs from expected phase " + std::to_string(phase));
                            }
                            const auto identity = sample.info().delegate().publication_virtual_sample_identity();
                            std::ostringstream guid_text;
                            std::ostringstream sequence_text;
                            guid_text << identity.writer_guid();
                            sequence_text << identity.sequence_number();
                            writer_guid = guid_text.str();
                            sequence_number = sequence_text.str();
                            received = true;
                        }
                    }
                    if (received) {
                        if (valid_samples != 1) {
                            throw std::runtime_error("Received multiple valid samples before lifecycle acknowledgment.");
                        }
                        std::vector<char> serialized;
                        const auto representation = xcdr2_fixture
                            ? dds::core::policy::DataRepresentation::xcdr2()
                            : dds::core::policy::DataRepresentation::xcdr();
                        const auto serialized_size = dds::topic::topic_type_support<DdsType>::to_cdr_buffer(
                            serialized, expected, representation).size();
                        const auto protocol_status = reader.extensions().datareader_protocol_status();
                        const auto received_fragments = protocol_status.received_fragment_count()
                            - previous_protocol_status.received_fragment_count();
                        const auto reassembled_samples = protocol_status.reassembled_sample_count()
                            - previous_protocol_status.reassembled_sample_count();
                        const auto dropped_fragments = protocol_status.dropped_fragment_count()
                            - previous_protocol_status.dropped_fragment_count();
                        const auto rejected_samples = protocol_status.rejected_sample_count().total()
                            - previous_protocol_status.rejected_sample_count().total();
                        if (fragmented_fixture && (phase == 1 || phase == 4)
                            && (serialized_size <= 16 * 1024 || received_fragments <= 0 || reassembled_samples <= 0)) {
                            throw std::runtime_error("Fragmentation counters did not prove reassembly for phase " + std::to_string(phase));
                        }
