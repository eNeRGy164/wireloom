#pragma once

#include "peer-qos.hpp"
#include <rti/topic/cdr.hpp>
#include <algorithm>
#include <iomanip>
#include <sstream>
#include <utility>

#ifdef WIRELOOM_RTI_7_3_1
#define WIRELOOM_SET_TYPED_STRING(member, value) expected.member(value)
#define WIRELOOM_SET_TYPED_STRING_ON(object, member, value) object.member(value)
#define WIRELOOM_SET_TYPED_MEMBER(member, value) expected.member(value)
#define WIRELOOM_SET_TYPED_MEMBER_ON(object, member, value) object.member(value)
#define WIRELOOM_TYPED_MEMBER(object, member) object.member()
#define WIRELOOM_SET_MEMBER_ON(object, member, value) object.member(value)
#define WIRELOOM_BOUNDED_SEQUENCE ::rti::core::bounded_sequence
#else
#define WIRELOOM_SET_TYPED_STRING(member, value) expected.member = value
#define WIRELOOM_SET_TYPED_STRING_ON(object, member, value) object.member = value
#define WIRELOOM_SET_TYPED_MEMBER(member, value) expected.member = value
#define WIRELOOM_SET_TYPED_MEMBER_ON(object, member, value) object.member = value
#define WIRELOOM_TYPED_MEMBER(object, member) object.member
#define WIRELOOM_SET_MEMBER_ON(object, member, value) object.member = value
#define WIRELOOM_BOUNDED_SEQUENCE ::omg::types::bounded_sequence
#endif

#if defined(WIRELOOM_TYPED_STRING_SEQUENCE_FIXTURE) || defined(WIRELOOM_TYPED_WIDE_STRINGS_FIXTURE) || defined(WIRELOOM_TYPED_STRING_BOUNDARIES_FIXTURE) || defined(WIRELOOM_TYPED_OPTIONAL_AGGREGATE_FIXTURE) || defined(WIRELOOM_TYPED_OPTIONAL_RECURSIVE_ARRAY_FIXTURE) || defined(WIRELOOM_TYPED_UNBOUNDED_STRING_ALIASES) || defined(WIRELOOM_TYPED_RESOLVE_NAME_WSTRING_ALIASES) || defined(WIRELOOM_TYPED_DEFAULT_LITERAL_ENUM_ARRAY) || defined(WIRELOOM_TYPED_NUMERIC_CHAR_UNION) || defined(WIRELOOM_TYPED_STRING_ALIAS_CHAINS) || defined(WIRELOOM_TYPED_UNBOUNDED_SEQUENCE_ALIASES) || defined(WIRELOOM_TYPED_UNION_STRING_SEQUENCE_ALIASES) || defined(WIRELOOM_TYPED_UNION_STRING_SEQUENCE_BOUNDED) || defined(WIRELOOM_TYPED_SEQUENCE_ARRAYS) || defined(WIRELOOM_TYPED_IDL_GAPS_FIXTURE) || defined(WIRELOOM_TYPED_C173_UNBOUNDED_SUPPORT) || defined(WIRELOOM_TYPED_C174_UNBOUNDED_RECEIVE_LIFECYCLE)

// RTI's generated DynamicData API omits some string template instantiations.
// Use RTI-generated typed C++ endpoints for these fixtures and compare the
// complete generated sample value at the reader.
static int run_typed_fixture_peer(
    dds::domain::DomainParticipant &participant,
    const std::string &role,
    const std::string &topic_name,
    int timeout_seconds,
    const std::string &case_id,
    const std::string &fixture)
{
    DdsType expected;
    const bool lifecycle_case = case_id == "14-unbounded-receive-lifecycle";
    const bool fragmented_fixture = fixture.rfind("fragmented-", 0) == 0;
    const bool xcdr2_fixture = fixture.size() >= 5
        && fixture.compare(fixture.size() - 5, 5, "xcdr2") == 0;
#ifdef WIRELOOM_TYPED_C174_UNBOUNDED_RECEIVE_LIFECYCLE
    auto set_lifecycle_phase = [&](DdsType &sample, int phase) {
        const bool fragmented = fixture.rfind("fragmented-", 0) == 0;
        const bool empty = phase == 0 || phase == 3;
        const auto pattern = [](int length, int seed) {
            std::string value;
            value.reserve(static_cast<size_t>(length) * 2);
            for (int index = 0; index < length; ++index) {
                const auto code_point = 0x03bb + ((seed + index * 7) % 4);
                value.push_back(static_cast<char>(0xce));
                value.push_back(static_cast<char>(0xbb + code_point - 0x03bb));
            }
            return value;
        };
        const auto wide_pattern = [](int length, int seed) {
            std::wstring value;
            value.reserve(static_cast<size_t>(length));
            for (int index = 0; index < length; ++index) {
                value.push_back(static_cast<wchar_t>(0x03a9 + ((seed + index * 7) % 4)));
            }
            return value;
        };
        const auto number = [](int phase_id, int index) {
            return (phase_id + 1) * 1000003 + index * 97 - 41;
        };
        WIRELOOM_SET_TYPED_MEMBER_ON(sample, phaseId, phase);
        auto &values = WIRELOOM_TYPED_MEMBER(sample, values);
        values.clear();
        const int value_count = empty ? 0 : (phase == 1 ? 257 : (phase == 4 ? 521 : 3));
        for (int index = 0; index < value_count; ++index) {
            values.push_back(number(phase, index));
        }
        WIRELOOM_SET_TYPED_STRING_ON(sample, text,
            pattern(empty ? 0 : phase == 1 ? (fragmented ? 170 * 1024 : 320)
                : phase == 4 ? (fragmented ? 350 * 1024 : 640) : 13, phase));
        WIRELOOM_SET_TYPED_STRING_ON(sample, wideText,
            wide_pattern(empty ? 0 : phase == 1 ? (fragmented ? 2048 : 320)
                : phase == 4 ? (fragmented ? 4096 : 640) : 9, phase));
        auto &labels = WIRELOOM_TYPED_MEMBER(sample, labels);
        labels.clear();
        const int label_count = empty ? 0 : (phase == 2 ? 2 : 8);
        for (int index = 0; index < label_count; ++index) {
            std::ostringstream label;
            label << 'p' << phase << "-l" << std::setw(3) << std::setfill('0') << index << '-'
                  << pattern(phase == 2 ? 5 : (fragmented ? 320 : 300), phase + index);
            labels.push_back(label.str());
        }
        auto &alias_values = WIRELOOM_TYPED_MEMBER(sample, aliasValues);
        alias_values.clear();
        for (int index = 0; index < value_count; ++index) {
            alias_values.push_back(number(phase + 1, index));
        }
        auto &bounded_values = WIRELOOM_TYPED_MEMBER(sample, boundedValues);
        bounded_values.clear();
        for (int index = 0; index < std::min(value_count, 4); ++index) {
            bounded_values.push_back(number(phase + 2, index));
        }
        std::ostringstream bounded;
        bounded << 'B' << std::setw(5) << std::setfill('0') << phase;
        WIRELOOM_SET_TYPED_STRING_ON(sample, boundedText, bounded.str());

        if (empty) {
#ifdef WIRELOOM_RTI_7_3_1
            ::rti::topic::reset_sample(sample.optionalState());
#else
            sample.optionalState.reset();
#endif
        } else {
            ::CorpusUnboundedReceiveLifecycle::OptionalState optional_state;
            WIRELOOM_SET_TYPED_MEMBER_ON(optional_state, value, 17400 + phase);
            auto &optional_labels = WIRELOOM_TYPED_MEMBER(optional_state, labels);
            optional_labels.clear();
            const int optional_label_count = phase == 2 ? 1 : phase == 4 ? 5 : 3;
            for (int index = 0; index < optional_label_count; ++index) {
                optional_labels.push_back("optional-" + std::to_string(phase) + "-label-"
                    + std::to_string(index) + "-" + pattern(phase == 4 ? 32 : 7, phase + index));
            }
            if (phase == 2) {
#ifdef WIRELOOM_RTI_7_3_1
                ::rti::topic::reset_sample(optional_state.note());
#else
                optional_state.note.reset();
#endif
            } else {
                std::string optional_note = "optional-" + std::to_string(phase) + "-note";
                WIRELOOM_SET_TYPED_STRING_ON(optional_state, note, optional_note);
            }
#ifdef WIRELOOM_RTI_7_3_1
            sample.optionalState(::dds::core::optional<::CorpusUnboundedReceiveLifecycle::OptionalState>(std::move(optional_state)));
#else
            sample.optionalState = std::move(optional_state);
#endif
        }
    };
    if (lifecycle_case) {
        set_lifecycle_phase(expected, 0);
        const auto representation = xcdr2_fixture
            ? dds::core::policy::DataRepresentation::xcdr2()
            : dds::core::policy::DataRepresentation::xcdr();
        for (int cycle = 0; cycle < 10; ++cycle) {
            DdsType reused;
            rti::topic::detail::initialize_sample_impl(reused);
            DdsType previous_native;
            DdsType previous_expected;
            bool has_previous = false;
            for (int phase = 0; phase < 5; ++phase) {
                set_lifecycle_phase(expected, phase);
                std::vector<char> serialized;
                dds::topic::topic_type_support<DdsType>::to_cdr_buffer(serialized, expected, representation);
                rti::topic::from_cdr_buffer_no_alloc(reused, serialized);
                if (!(reused == expected)) {
                    throw std::runtime_error("Reused native CDR deserialization differs at lifecycle phase " + std::to_string(phase));
                }
                if (has_previous && !(previous_native == previous_expected)) {
                    throw std::runtime_error("Deserializing the next native lifecycle phase mutated the retained prior value");
                }
                previous_native = reused;
                previous_expected = expected;
                has_previous = true;
            }
        }
        set_lifecycle_phase(expected, 0);
        std::cout << "LIFECYCLE_NATIVE_CDR phases=5 cycles=10 reused_storage=true aliases=true string_sequence_elements=true optional_transitions=true nested_transitions=true ownership_snapshot=true cleanup=scope-exit" << std::endl;
    }
#endif
#ifdef WIRELOOM_TYPED_C163_EXTENSIBILITY
    if (case_id == "14-extensibility-full") {
        WIRELOOM_SET_TYPED_MEMBER(value, 16301);
        if (WIRELOOM_TYPED_MEMBER(expected, value) != 16301) {
            throw std::runtime_error("C163 fixture value did not retain its explicit expected value");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C164_AUTOID_SCOPE
    if (case_id == "14-autoid-scope") {
        auto &hashed = WIRELOOM_TYPED_MEMBER(expected, hashed);
        WIRELOOM_SET_TYPED_MEMBER_ON(hashed, first, 16401);
        WIRELOOM_SET_TYPED_MEMBER_ON(hashed, second, 16402);
        auto &reopened = WIRELOOM_TYPED_MEMBER(expected, reopened);
        WIRELOOM_SET_TYPED_MEMBER_ON(reopened, first, 16411);
        WIRELOOM_SET_TYPED_MEMBER_ON(reopened, second, 16412);
        auto &sequential = WIRELOOM_TYPED_MEMBER(expected, sequential);
        WIRELOOM_SET_TYPED_MEMBER_ON(sequential, first, 16421);
        WIRELOOM_SET_TYPED_MEMBER_ON(sequential, second, 16422);
        auto &uses_include = WIRELOOM_TYPED_MEMBER(expected, usesInclude);
        auto &included = WIRELOOM_TYPED_MEMBER(uses_include, included);
        WIRELOOM_SET_TYPED_MEMBER_ON(included, first, 16431);
        WIRELOOM_SET_TYPED_MEMBER_ON(included, second, 16432);
        if (WIRELOOM_TYPED_MEMBER(hashed, first) != 16401
            || WIRELOOM_TYPED_MEMBER(reopened, second) != 16412
            || WIRELOOM_TYPED_MEMBER(sequential, first) != 16421
            || WIRELOOM_TYPED_MEMBER(included, second) != 16432) {
            throw std::runtime_error("C164 typed fixture values do not match the independent scope expectations");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C165_ANNOTATION_ARGUMENTS
    if (case_id == "14-annotation-arguments") {
        if (fixture == "default") {
            if (WIRELOOM_TYPED_MEMBER(expected, plain) != 0
                || WIRELOOM_TYPED_MEMBER(expected, selected) != 42) {
                throw std::runtime_error("C165 constructor values do not match the annotation defaults");
            }
        } else if (fixture == "non-default") {
            WIRELOOM_SET_TYPED_MEMBER(plain, 16501);
            WIRELOOM_SET_TYPED_MEMBER(selected, 16502);
        } else {
            throw std::runtime_error("Unknown C165 annotation fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C166_MEMBER_DECLARATORS
    if (case_id == "14-member-declarators") {
        WIRELOOM_SET_TYPED_MEMBER(first, 16601);
        WIRELOOM_SET_TYPED_MEMBER(second, 16602);
        auto &numbers = WIRELOOM_TYPED_MEMBER(expected, numbers);
        numbers[0] = 16611;
        numbers[1] = 16612;
        auto &matrix = WIRELOOM_TYPED_MEMBER(expected, matrix);
        matrix[0][0] = 16621;
        matrix[0][1] = 16622;
        matrix[0][2] = 16623;
        matrix[1][0] = 16631;
        matrix[1][1] = 16632;
        matrix[1][2] = 16633;
    }
#endif
#ifdef WIRELOOM_TYPED_C167_UNION_LABELS
    if (case_id == "14-union-label-expressions") {
        if (fixture == "symbolic") {
            expected.symbolic(16701);
            if (expected._d() != 42) {
                throw std::runtime_error("C167 symbolic label did not select discriminator 42");
            }
        } else if (fixture == "arithmetic") {
            expected.arithmetic(16702);
            if (expected._d() != 4) {
                throw std::runtime_error("C167 arithmetic label did not select discriminator 4");
            }
        } else if (fixture == "hexadecimal") {
            expected.hexadecimal(16703);
            if (expected._d() != 16) {
                throw std::runtime_error("C167 hexadecimal label did not select discriminator 16");
            }
        } else {
            throw std::runtime_error("Unknown C167 union label fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C168_SCOPED_ENUM
    if (case_id == "14-union-scoped-enum") {
        if (fixture == "enum-selected") {
            expected.selected(16801);
            if (expected._d() != Choice::SECOND) {
                throw std::runtime_error("C168 enum constant did not select Choice::SECOND");
            }
        } else if (fixture == "enum-first") {
            expected.first(16802);
            if (expected._d() != Choice::FIRST) {
                throw std::runtime_error("C168 enum label did not select Choice::FIRST");
            }
        } else {
            throw std::runtime_error("Unknown C168 enum fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C169_UNION_ARRAY
    if (case_id == "14-union-array-branch") {
        if (fixture == "array-branch") {
            auto &values = expected.values();
            values[0][0] = 16901;
            values[0][1] = 16902;
            values[0][2] = 16903;
            values[1][0] = 16911;
            values[1][1] = 16912;
            values[1][2] = 16913;
            if (expected._d() != 0 || values[1][2] != 16913) {
                throw std::runtime_error("C169 fixed array fixture did not select or populate its array branch");
            }
        } else if (fixture == "scalar-branch") {
            expected.scalar(16921);
            if (expected._d() != 1 || expected.scalar() != 16921) {
                throw std::runtime_error("C169 scalar branch fixture selected the wrong union member");
            }
        } else {
            throw std::runtime_error("Unknown C169 union array fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C170_STRING_BOUND
    if (case_id == "14-string-expression-bound") {
        WIRELOOM_SET_TYPED_STRING(text, "12345");
        WIRELOOM_SET_TYPED_STRING(wideText, L"ABCDEF");
        if (WIRELOOM_TYPED_MEMBER(expected, text).size() != 5
            || WIRELOOM_TYPED_MEMBER(expected, wideText).size() != 6) {
            throw std::runtime_error("C170 expression-bound string fixtures have incorrect lengths");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C171_DEFAULTS
    if (case_id == "14-typed-defaults") {
        if (fixture == "default") {
            if (WIRELOOM_TYPED_MEMBER(expected, inherited) != 7
                || WIRELOOM_TYPED_MEMBER(expected, overridden) != 9
                || WIRELOOM_TYPED_MEMBER(expected, text) != "alias"
                || WIRELOOM_TYPED_MEMBER(expected, ratio) != 1.5
                || WIRELOOM_TYPED_MEMBER(expected, single) != 1.25f) {
                throw std::runtime_error("C171 generated constructor defaults differ from the independent IDL values");
            }
        } else if (fixture == "non-default") {
            WIRELOOM_SET_TYPED_MEMBER(inherited, 17101);
            WIRELOOM_SET_TYPED_MEMBER(overridden, 17102);
            WIRELOOM_SET_TYPED_STRING(text, "explicit");
            WIRELOOM_SET_TYPED_MEMBER(ratio, 2.25);
            WIRELOOM_SET_TYPED_MEMBER(single, -3.5f);
        } else {
            throw std::runtime_error("Unknown C171 defaults fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C172_ENUM_CONSTANT
    if (case_id == "14-enum-constant") {
        auto &value = WIRELOOM_TYPED_MEMBER(expected, value);
        WIRELOOM_SET_TYPED_MEMBER_ON(value, color, Color::GREEN);
        auto &choice = WIRELOOM_TYPED_MEMBER(expected, choice);
        choice.selected(17201);
        if (WIRELOOM_TYPED_MEMBER(value, color) != Color::GREEN
            || choice._d() != Color::GREEN
            || choice.selected() != 17201) {
            throw std::runtime_error("C172 enum constant did not match the expected enum value and union label");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_C173_UNBOUNDED_SUPPORT
    if (case_id == "14-unbounded-support") {
        std::vector<int32_t> values;
        for (int32_t index = 0; index < 103; ++index) {
            values.push_back(index - 51);
        }
        WIRELOOM_SET_TYPED_MEMBER(values, std::move(values));
        WIRELOOM_SET_TYPED_STRING(text, std::string(300, 'n'));
        WIRELOOM_SET_TYPED_STRING(wideText, std::wstring(16, static_cast<wchar_t>(0x03bb)));
        std::vector<std::string> labels{
            "label-000000", "label-000001", "label-000002", "label-000003", "label-000004",
            "label-000005", "label-000006", "label-000007", "label-000008"};
        WIRELOOM_SET_TYPED_MEMBER(labels, std::move(labels));
        ::CorpusUnboundedSupport::LongValues alias_values;
        for (int32_t index = 0; index < 101; ++index) {
            alias_values.push_back(index + 1000);
        }
        WIRELOOM_SET_TYPED_MEMBER(aliasValues, std::move(alias_values));
        auto &bounded_values = WIRELOOM_TYPED_MEMBER(expected, boundedValues);
        bounded_values.push_back(4);
        bounded_values.push_back(-4);
        bounded_values.push_back(INT32_MIN);
        bounded_values.push_back(INT32_MAX);
        WIRELOOM_SET_TYPED_STRING(boundedText, "12345678");

        const auto &actual_values = WIRELOOM_TYPED_MEMBER(expected, values);
        const auto &actual_labels = WIRELOOM_TYPED_MEMBER(expected, labels);
        const auto &actual_alias_values = WIRELOOM_TYPED_MEMBER(expected, aliasValues);
        if (actual_values.size() != 103 || actual_labels.size() != 9 || actual_alias_values.size() != 101
            || WIRELOOM_TYPED_MEMBER(expected, text).size() != 300
            || WIRELOOM_TYPED_MEMBER(expected, wideText).size() != 16
            || WIRELOOM_TYPED_MEMBER(expected, boundedText) != "12345678") {
            throw std::runtime_error("C173 unbounded fixture values do not match their independent expected sizes");
        }
    }
#endif
#ifdef WIRELOOM_TYPED_SEQUENCE_ARRAYS
    if (case_id == "05-array-of-sequences-idl") {
        auto &values = WIRELOOM_TYPED_MEMBER(expected, values);
        auto &names = WIRELOOM_TYPED_MEMBER(expected, names);
        if (fixture == "sequence-unequal") {
            values[0].push_back(101);
            values[0].push_back(-102);
            values[1].push_back(203);
            names[0].push_back("first");
            names[1].push_back("second");
            names[1].push_back("third");
        } else if (fixture == "sequence-mixed-empty") {
            values[1].push_back(-301);
            values[1].push_back(302);
            names[0].push_back("only-first");
        } else if (fixture == "sequence-boundary") {
            values[0].push_back(INT32_MIN);
            values[1].push_back(INT32_MAX);
            names[0].push_back("1234567890123456");
            names[0].push_back("");
            names[0].push_back("last");
            names[1].push_back("other");
        } else if (fixture != "sequence-empty") {
            throw std::runtime_error("Unknown sequence-array fixture: " + fixture);
        }
    }
#endif
#ifdef WIRELOOM_TYPED_UNBOUNDED_SEQUENCE_ALIASES
    if (case_id == "05-unbounded-sequence-aliases" && fixture == "sequence-multiple") {
        ::CorpusUnboundedSequences::Numbers numbers;
        ::CorpusUnboundedSequences::States states;
        ::CorpusUnboundedSequences::Children children;
        ::CorpusUnboundedSequences::Scalars scalars;
        ::CorpusUnboundedSequences::Texts texts;
        ::CorpusUnboundedSequences::WideTexts wide_texts;
        for (int index = 0; index < 257; ++index) {
            numbers.push_back(index - 128);
            states.push_back(index % 2 == 0
                ? ::CorpusUnboundedSequences::State::Idle
                : ::CorpusUnboundedSequences::State::Ready);
            ::CorpusUnboundedSequences::Child child;
            WIRELOOM_SET_TYPED_MEMBER_ON(child, value, index - 128);
            children.push_back(child);
            scalars.push_back(index + 1000);
            if (index == 128) {
                texts.push_back(std::string(300, 'n'));
                wide_texts.push_back(std::wstring(300, L'λ'));
            } else {
                std::ostringstream narrow_index;
                narrow_index << std::setfill('0') << std::setw(3) << index;
                texts.push_back("text-" + narrow_index.str());
                std::wostringstream wide_index;
                wide_index << std::setfill(L'0') << std::setw(3) << index;
                wide_texts.push_back(L"wide-" + wide_index.str() + L"-λ");
            }
        }
        WIRELOOM_SET_TYPED_MEMBER(numbers, std::move(numbers));
        WIRELOOM_SET_TYPED_MEMBER(states, std::move(states));
        WIRELOOM_SET_TYPED_MEMBER(children, std::move(children));
        WIRELOOM_SET_TYPED_MEMBER(scalars, std::move(scalars));
        WIRELOOM_SET_TYPED_MEMBER(texts, std::move(texts));
        WIRELOOM_SET_TYPED_MEMBER(wideTexts, std::move(wide_texts));
        ::CorpusUnboundedSequences::BoundedTexts bounded_texts;
        bounded_texts.push_back("12345678");
        bounded_texts.push_back("bounded");
        WIRELOOM_SET_TYPED_MEMBER(boundedTexts, std::move(bounded_texts));
        ::CorpusUnboundedSequences::BoundedWideTexts bounded_wide_texts;
        bounded_wide_texts.push_back(L"ABCD");
        bounded_wide_texts.push_back(L"wide");
        WIRELOOM_SET_TYPED_MEMBER(boundedWideTexts, std::move(bounded_wide_texts));
    }
#endif
#ifdef WIRELOOM_TYPED_UNION_STRING_SEQUENCE_ALIASES
    if (case_id == "07-union-string-sequence-aliases") {
        const bool wide = fixture == "union-direct-wide" || fixture == "union-alias-wide"
            || fixture == "union-bounded-wide";
        const bool bounded = fixture.find("bounded") != std::string::npos;
        ::RuntimeUnionStringSequences::DirectStringSequences direct;
        ::RuntimeUnionStringSequences::StringSequenceAliases aliases;
        if (fixture.find("direct") != std::string::npos) {
            if (wide) {
                WIRELOOM_BOUNDED_SEQUENCE<std::wstring, 3> values;
                values.push_back(L"wide-λ");
                values.push_back(L"wide-2");
                values.push_back(L"wide-3");
                direct.wide(std::move(values));
            } else {
                WIRELOOM_BOUNDED_SEQUENCE<std::string, 3> values;
                values.push_back("narrow-1");
                values.push_back("narrow-2");
                values.push_back("narrow-3");
                direct.narrow(std::move(values));
            }
            WIRELOOM_SET_TYPED_MEMBER(direct, std::move(direct));
        } else if (bounded && wide) {
            ::RuntimeUnionStringSequences::BoundedWideTexts values;
            values.push_back(L"ABCD");
            values.push_back(L"wide");
            values.push_back(L"LAST");
            aliases.boundedWide(std::move(values));
            WIRELOOM_SET_TYPED_MEMBER(aliases, std::move(aliases));
        } else if (bounded) {
            ::RuntimeUnionStringSequences::BoundedNarrowTexts values;
            values.push_back("12345678");
            values.push_back("bounded");
            values.push_back("ABCDEFGH");
