if(NOT EXISTS "${RTI_CAPTURE}" OR NOT EXISTS "${WIRELOOM_CAPTURE}")
    message(FATAL_ERROR "Both CDR capture files must exist")
endif()
file(SHA256 "${RTI_CAPTURE}" rti_hash)
file(SHA256 "${WIRELOOM_CAPTURE}" wireloom_hash)
if(NOT rti_hash STREQUAL wireloom_hash)
    message(FATAL_ERROR "RTI and Wireloom CDR captures differ (${rti_hash} != ${wireloom_hash})")
endif()
message(STATUS "RTI and Wireloom CDR capture hashes match: ${rti_hash}")
