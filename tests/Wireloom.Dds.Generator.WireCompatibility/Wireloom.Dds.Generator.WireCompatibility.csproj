<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Wireloom.Dds.Generator.WireCompatibility</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)wireloom-generated</CompilerGeneratedFilesOutputPath>
    <CompilerGeneratedFilesOutputPath Condition="'$(WireCompatibilityGeneratedOutputPath)' != ''">$(WireCompatibilityGeneratedOutputPath)</CompilerGeneratedFilesOutputPath>
    <WireCompatibilityCase Condition="'$(WireCompatibilityCase)' == ''">01-primitives</WireCompatibilityCase>
    <WireCompatibilityRtiVersion Condition="'$(WireCompatibilityRtiVersion)' == ''">7.7.0</WireCompatibilityRtiVersion>
    <RtiConnextDdsVersion Condition="'$(RtiConnextDdsVersion)' == ''">$(WireCompatibilityRtiVersion)</RtiConnextDdsVersion>
    <NuGetLockFilePath Condition="'$(WireCompatibilityRtiVersion)' != '7.7.0'">packages.$(WireCompatibilityRtiVersion).lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\obj\packages\$(WireCompatibilityRtiVersion)</RestorePackagesPath>
    <AssemblyName>WireCompatibility.$(WireCompatibilityCase)</AssemblyName>
    <DdsIdlIncludeDirectories>$(MSBuildProjectDirectory)\..\..\docs\corpus\idl;$(MSBuildProjectDirectory)\..\..\docs\corpus\idl\includes</DdsIdlIncludeDirectories>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WireCompatibilityIsolatedIntermediateOutputPath)' == 'true'">
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);obj/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '05-array-of-sequences-idl'">
    <WireCompatibilityIdl>$(MSBuildProjectDirectory)/../../docs/corpus/idl/features/05-array-of-sequences.idl</WireCompatibilityIdl>
    <DdsIdlSequenceArrayMapping>Idl</DdsIdlSequenceArrayMapping>
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_SEQUENCE_ARRAYS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <WireCompatibilityIdl Condition="'$(WireCompatibilityIdl)' == ''">$(MSBuildProjectDirectory)/../../docs/corpus/idl/features/$(WireCompatibilityCase).idl</WireCompatibilityIdl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '07-union-char-numeric-255'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_NUMERIC_CHAR_255_UNION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '07-union-char-numeric'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_NUMERIC_CHAR_UNION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '05-unbounded-sequence-aliases'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_UNBOUNDED_SEQUENCE_ALIASES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '04-unbounded-string-aliases' or '$(WireCompatibilityCase)' == '05-unbounded-sequence-aliases'">
    <DdsIdlUnboundedSupport>true</DdsIdlUnboundedSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '07-union-string-sequence-aliases'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_UNION_STRING_SEQUENCE_ALIASES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-unbounded-support'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_UNBOUNDED_SUPPORT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-unbounded-receive-lifecycle'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_UNBOUNDED_RECEIVE_LIFECYCLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-extensibility-full' or '$(WireCompatibilityCase)' == '14-autoid-scope' or '$(WireCompatibilityCase)' == '14-annotation-arguments' or '$(WireCompatibilityCase)' == '14-member-declarators' or '$(WireCompatibilityCase)' == '14-union-label-expressions' or '$(WireCompatibilityCase)' == '14-union-scoped-enum' or '$(WireCompatibilityCase)' == '14-union-array-branch' or '$(WireCompatibilityCase)' == '14-string-expression-bound' or '$(WireCompatibilityCase)' == '14-typed-defaults' or '$(WireCompatibilityCase)' == '14-enum-constant'">
    <DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_IDL_GAPS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-extensibility-full'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C163</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-autoid-scope'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C164</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-annotation-arguments'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C165</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-member-declarators'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C166</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-union-label-expressions'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C167</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-union-scoped-enum'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C168</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-union-array-branch'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C169</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-string-expression-bound'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C170</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-typed-defaults'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C171</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(WireCompatibilityCase)' == '14-enum-constant'"><DefineConstants>$(DefineConstants);WIRE_COMPATIBILITY_C172</DefineConstants></PropertyGroup>

  <ItemGroup>
    <!-- The RTI control probe is a nested project. Do not compile its sources or generated obj files here. -->
    <Compile Remove="RtiOracleProbe/**/*.cs" />
    <!-- These remain directly invokable file-based tools, not peer-project source files. -->
    <Compile Remove="scripts/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler is a runtime dependency of the generator when both are project-reference analyzers. -->
    <ProjectReference Include="..\..\src\Wireloom.Dds.Compiler\Wireloom.Dds.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="OutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;WireCompatibilityIsolatedIntermediateOutputPath" />
    <ProjectReference Include="..\..\src\Wireloom.Dds.Generator\Wireloom.Dds.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="OutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;WireCompatibilityIsolatedIntermediateOutputPath" />
    <ProjectReference Include="..\Wireloom.Dds.Generator.TestSupport\Wireloom.Dds.Generator.TestSupport.csproj"
                      GlobalPropertiesToRemove="OutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;WireCompatibilityIsolatedIntermediateOutputPath" />
    <ProjectReference Include="..\Wireloom.Dds.Generator.WireCompatibility.Shared\Wireloom.Dds.Generator.WireCompatibility.Shared.csproj"
                      GlobalPropertiesToRemove="OutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;WireCompatibilityIsolatedIntermediateOutputPath" />
    <PackageReference Remove="Shouldly;xunit.v3.mtp-v2" />
    <PackageReference Include="Rti.ConnextDds" Version="$(WireCompatibilityRtiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Shouldly;Xunit" />
  </ItemGroup>

  <ItemGroup>
    <DdsIdl Include="$(WireCompatibilityIdl)"
            Condition="'$(WireCompatibilityCase)' != '02-multiple' and '$(WireCompatibilityCase)' != '03-enum-values-prefix' and '$(WireCompatibilityCase)' != '03-enum-values-explicit' and '$(WireCompatibilityCase)' != '14-autoid-scope' and '$(WireCompatibilityCase)' != '14-enum-constant'" />
    <DdsIdl Include="IdlWrappers\$(WireCompatibilityCase).idl"
            Condition="'$(WireCompatibilityCase)' == '02-multiple' or '$(WireCompatibilityCase)' == '03-enum-values-prefix' or '$(WireCompatibilityCase)' == '03-enum-values-explicit' or '$(WireCompatibilityCase)' == '04-unbounded-string-aliases' or '$(WireCompatibilityCase)' == '05-unbounded-sequence-aliases' or '$(WireCompatibilityCase)' == '04-string-alias-chains' or '$(WireCompatibilityCase)' == '07-union-string-sequence-aliases'" />
    <DdsIdl Include="IdlWrappers\14-autoid-scope-topic.idl" Condition="'$(WireCompatibilityCase)' == '14-autoid-scope'" />
    <DdsIdl Include="IdlWrappers\14-enum-constant-topic.idl" Condition="'$(WireCompatibilityCase)' == '14-enum-constant'" />
    <DdsIdl Update="..\..\docs\corpus\idl\features\11-preprocessing.idl"
            Condition="'$(WireCompatibilityCase)' == '11-preprocessing'"
            Defines="CORPUS_CAPTURE_DEFINE" />
    <DdsIdl Update="..\..\docs\corpus\idl\features\14-unbounded-support.idl"
            Condition="'$(WireCompatibilityCase)' == '14-unbounded-support'"
            SequenceSize="7" StringSize="9" UnboundedSupport="true" />
    <DdsIdl Update="..\..\docs\corpus\idl\features\14-unbounded-receive-lifecycle.idl"
            Condition="'$(WireCompatibilityCase)' == '14-unbounded-receive-lifecycle'"
            SequenceSize="7" StringSize="9" UnboundedSupport="true" />
  </ItemGroup>

  <Import Project="..\..\src\Wireloom.Dds.Generator\build\Wireloom.Dds.Generator.targets" />
</Project>
