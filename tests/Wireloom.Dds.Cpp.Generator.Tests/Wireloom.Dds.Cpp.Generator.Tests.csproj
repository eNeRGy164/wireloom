  <!-- Keep ordinary suites separate. The coverage-only build hosts all three
       suites so the collector retains exact branch data without XML merging. -->
  <PropertyGroup Condition="'$(WireloomCppCombinedCoverage)' == 'true'">
    <OutputPath>bin/$(Configuration)/combined/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/combined/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(WireloomCppCombinedCoverage)' == 'true'">
    <Compile Include="../Wireloom.Dds.Cpp.Compiler.Tests/**/*.cs"
             Exclude="../Wireloom.Dds.Cpp.Compiler.Tests/bin/**;../Wireloom.Dds.Cpp.Compiler.Tests/obj/**"
             Link="Compiler/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Wireloom.Dds.Cpp.CorpusCompliance/**/*.cs"
             Exclude="../Wireloom.Dds.Cpp.CorpusCompliance/bin/**;../Wireloom.Dds.Cpp.CorpusCompliance/obj/**"
             Link="Corpus/%(RecursiveDir)%(Filename)%(Extension)" />
