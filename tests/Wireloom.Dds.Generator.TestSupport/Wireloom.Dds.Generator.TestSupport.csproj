<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Wireloom.Dds.Generator.TestSupport</RootNamespace>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <NuGetLockFilePath Condition="'$(RtiConnextDdsVersion)' != '7.7.0'">packages.$(RtiConnextDdsVersion).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RtiConnextDdsVersion)' == '6.1.2'">
    <DefineConstants>$(DefineConstants);WIRELOOM_RTI_6_1_2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rti.ConnextDds" />
    <PackageReference Remove="Shouldly;xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="Shouldly;Xunit" />
  </ItemGroup>

</Project>
