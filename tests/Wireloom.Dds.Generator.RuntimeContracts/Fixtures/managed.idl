module RuntimeManaged {
    enum State { Idle, Ready };
    struct Child { @key long id; string<16> text; };
    struct Scalars {
        boolean flag;
        octet byteValue;
        int8 signedByte;
        uint8 unsignedByte;
        short shortValue;
        unsigned short unsignedShort;
        long intValue;
        unsigned long unsignedInt;
        long long longValue;
        unsigned long long unsignedLong;
        float singleValue;
        double doubleValue;
        long double extendedValue;
        char character;
        wchar wideCharacter;
        State state;
        string<16> text;
        wstring<16> wideText;
        @default(42) long defaultNumber;
    };
    struct Collections {
        Child child;
        sequence<long, 4> numbers;
        sequence<Child> children;
        long vector[2];
        long matrix[2][3];
        Child points[2];
        sequence<string<16>, 3> texts;
        sequence<wstring<16>> wideTexts;
        @optional long optionalNumber;
        @optional string<16> optionalText;
        @optional Child optionalChild;
        @optional sequence<long, 4> optionalNumbers;
        @optional Child optionalPoints[2];
        @optional State optionalState;
        @optional wstring<16> optionalWideText;
        @optional sequence<wstring<16>, 3> optionalWideTexts;
        @optional long optionalMatrix[2][3];
    };
    struct KeyedEnvelope { @key Child identity; long payload; };
    struct Base { @key long id; @optional string<16> note; };
    struct Derived : Base { string<16> text; @optional long extra; };
    valuetype BaseValue { public long id; };
    valuetype DerivedValue : BaseValue { public string<16> text; };
};
