<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Wireloom.Dds.Generator.RuntimeContracts</RootNamespace>
    <!-- Override the consumer target without retargeting the analyzer project. -->
    <TargetFramework Condition="'$(WireloomConsumerTargetFramework)' != ''">$(WireloomConsumerTargetFramework)</TargetFramework>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\obj\packages\$(RtiConnextDdsVersion)</RestorePackagesPath>
    <NuGetLockFilePath Condition="'$(RtiConnextDdsVersion)' != '' and '$(RtiConnextDdsVersion)' != '7.7.0'">packages.$(RtiConnextDdsVersion).lock.json</NuGetLockFilePath>
    <RestorePackagesWithLockFile Condition="'$(RtiConnextDdsVersion)' != '' and '$(RtiConnextDdsVersion)' != '7.7.0'">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(TargetFramework)' == 'net8.0'">packages.$(RtiConnextDdsVersion).net8.0.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The compiler is a runtime dependency of the generator when both are project-reference analyzers. -->
    <ProjectReference Include="../../src/Wireloom.Dds.Compiler/Wireloom.Dds.Compiler.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Wireloom.Dds.Generator/Wireloom.Dds.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Rti.ConnextDds" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <DdsIdl Include="Fixtures/*.idl" />
    <DdsIdl Update="Fixtures/sequence-arrays.idl" SequenceArrayMapping="Idl" />
    <DdsIdl Update="Fixtures/recursive-startup.idl" UnboundedSupport="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
  </ItemGroup>

  <Import Project="../../src/Wireloom.Dds.Generator/build/Wireloom.Dds.Generator.targets" />
</Project>
