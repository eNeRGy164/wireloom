include_guard(GLOBAL)

set(WIRELOOM_CPP_RTI_VERSION "7.7.0" CACHE STRING "RTI Connext runtime version targeted by generated C++ source")

# Attach an IDL generation rule to a native target in the calling directory.
function(wireloom_add_idl target)
    cmake_parse_arguments(PARSE_ARGV 1 WIRELOOM "UNBOUNDED_SUPPORT;FINITE_SUPPORT;ENABLE_ESCAPE_CHAR;STRICT" "IDL;SEQUENCE_SIZE;STRING_SIZE" "DEFINES;UNDEFINES;INCLUDE_DIRECTORIES;FILE_SEQUENCE_SIZES;FILE_STRING_SIZES;FILE_UNBOUNDED_SUPPORT")
    if(NOT WIRELOOM_IDL OR WIRELOOM_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Use wireloom_add_idl(<target> IDL <path> [DEFINES ...] [UNDEFINES ...] [INCLUDE_DIRECTORIES ...] [SEQUENCE_SIZE <size>] [STRING_SIZE <size>] [FILE_SEQUENCE_SIZES <path> <size> ...] [FILE_STRING_SIZES <path> <size> ...] [FILE_UNBOUNDED_SUPPORT <path> <true|false> ...] [STRICT] [ENABLE_ESCAPE_CHAR] [UNBOUNDED_SUPPORT|FINITE_SUPPORT]).")
    endif()

    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Create target '${target}' before calling wireloom_add_idl.")
    endif()

    get_target_property(_target_source_dir "${target}" SOURCE_DIR)
    if(NOT _target_source_dir STREQUAL CMAKE_CURRENT_SOURCE_DIR)
        message(FATAL_ERROR "Call wireloom_add_idl in the directory where '${target}' is defined.")
    endif()

    get_property(_has_idl TARGET "${target}" PROPERTY WIRELOOM_GENERATED_DIR SET)
    if(_has_idl)
        message(FATAL_ERROR "This version of Wireloom accepts one IDL file per target.")
    endif()

    get_filename_component(_idl "${WIRELOOM_IDL}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT EXISTS "${_idl}" OR IS_DIRECTORY "${_idl}")
        message(FATAL_ERROR "Wireloom IDL file does not exist: ${_idl}")
    endif()

    get_filename_component(_package_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    if(NOT EXISTS "${_package_root}/tools")
        get_filename_component(_package_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
    endif()
    if(DEFINED WIRELOOM_CPP_TOOL AND NOT WIRELOOM_CPP_TOOL STREQUAL "")
        set(_tool "${WIRELOOM_CPP_TOOL}")
    elseif(CMAKE_HOST_WIN32 AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        set(_tool "${_package_root}/tools/win-x64/Wireloom.Dds.Cpp.exe")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
        set(_tool "${_package_root}/tools/linux-x64/Wireloom.Dds.Cpp")
    else()
        message(FATAL_ERROR "Wireloom C++ generator has no native tool for build host ${CMAKE_HOST_SYSTEM_NAME}/${CMAKE_HOST_SYSTEM_PROCESSOR}. Set WIRELOOM_CPP_TOOL to a compatible executable.")
    endif()
    if(NOT EXISTS "${_tool}")
        message(FATAL_ERROR "The installed Wireloom C++ generator is missing: ${_tool}. Set WIRELOOM_CPP_TOOL to an available executable.")
    endif()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        file(CHMOD "${_tool}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()

    get_filename_component(_name "${_idl}" NAME_WLE)
    set(_generated_dir "${CMAKE_CURRENT_BINARY_DIR}/wireloom/${target}")
    if(WIRELOOM_UNBOUNDED_SUPPORT AND WIRELOOM_FINITE_SUPPORT)
        message(FATAL_ERROR "Select either UNBOUNDED_SUPPORT or FINITE_SUPPORT for '${target}'.")
    endif()
    file(GLOB_RECURSE _include_inputs CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.idl")
    get_filename_component(_idl_directory "${_idl}" DIRECTORY)
    file(GLOB_RECURSE _idl_directory_inputs CONFIGURE_DEPENDS "${_idl_directory}/*.idl")
    list(APPEND _include_inputs ${_idl_directory_inputs})
    foreach(_include_directory IN LISTS WIRELOOM_INCLUDE_DIRECTORIES)
        get_filename_component(_include_directory "${_include_directory}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(IS_DIRECTORY "${_include_directory}")
            file(GLOB_RECURSE _directory_idl CONFIGURE_DEPENDS "${_include_directory}/*.idl")
            list(APPEND _include_inputs ${_directory_idl})
        endif()
    endforeach()
    foreach(_file_setting FILE_SEQUENCE_SIZES FILE_STRING_SIZES FILE_UNBOUNDED_SUPPORT)
        list(LENGTH WIRELOOM_${_file_setting} _file_setting_count)
        math(EXPR _file_setting_remainder "${_file_setting_count} % 2")
        if(_file_setting_remainder)
            message(FATAL_ERROR "${_file_setting} requires path/value pairs for '${target}'.")
        endif()
    endforeach()
    set(_outputs
        "${_generated_dir}/${_name}.hpp"
        "${_generated_dir}/${_name}.cxx"
        "${_generated_dir}/${_name}Plugin.hpp"
        "${_generated_dir}/${_name}Plugin.cxx")
    set(_generation_options)
    list(APPEND _generation_options --rti-version "${WIRELOOM_CPP_RTI_VERSION}")
    if(WIRELOOM_UNBOUNDED_SUPPORT)
        list(APPEND _generation_options --unbounded-support)
    endif()
    if(WIRELOOM_FINITE_SUPPORT)
        list(APPEND _generation_options --finite-support)
    endif()
    if(WIRELOOM_ENABLE_ESCAPE_CHAR)
        list(APPEND _generation_options --enable-escape-char)
    endif()
    if(WIRELOOM_STRICT)
        list(APPEND _generation_options --strict)
    endif()
    if(WIRELOOM_SEQUENCE_SIZE)
        list(APPEND _generation_options --sequence-size "${WIRELOOM_SEQUENCE_SIZE}")
    endif()
    if(WIRELOOM_STRING_SIZE)
        list(APPEND _generation_options --string-size "${WIRELOOM_STRING_SIZE}")
    endif()
    foreach(_define IN LISTS WIRELOOM_DEFINES)
        list(APPEND _generation_options --define "${_define}")
    endforeach()
    foreach(_undefine IN LISTS WIRELOOM_UNDEFINES)
        list(APPEND _generation_options --undefine "${_undefine}")
    endforeach()
    foreach(_include_directory IN LISTS WIRELOOM_INCLUDE_DIRECTORIES)
        get_filename_component(_include_directory "${_include_directory}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND _generation_options --include-directory "${_include_directory}")
    endforeach()
    foreach(_file_setting FILE_SEQUENCE_SIZES FILE_STRING_SIZES FILE_UNBOUNDED_SUPPORT)
        list(LENGTH WIRELOOM_${_file_setting} _file_setting_count)
        if(_file_setting_count GREATER 0)
            math(EXPR _file_setting_last_index "${_file_setting_count} - 1")
            foreach(_index RANGE 0 ${_file_setting_last_index} 2)
                math(EXPR _value_index "${_index} + 1")
                list(GET WIRELOOM_${_file_setting} ${_index} _file_setting_path)
                list(GET WIRELOOM_${_file_setting} ${_value_index} _file_setting_value)
                get_filename_component(_file_setting_path "${_file_setting_path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
                if(_file_setting STREQUAL "FILE_SEQUENCE_SIZES")
                    list(APPEND _generation_options --file-sequence-size "${_file_setting_path}" "${_file_setting_value}")
                elseif(_file_setting STREQUAL "FILE_STRING_SIZES")
                    list(APPEND _generation_options --file-string-size "${_file_setting_path}" "${_file_setting_value}")
                else()
                    list(APPEND _generation_options --file-unbounded-support "${_file_setting_path}" "${_file_setting_value}")
                endif()
            endforeach()
        endif()
    endforeach()
    set(_rti_profile_stamp "${CMAKE_CURRENT_BINARY_DIR}/wireloom/${target}/rti-version.txt")
    file(GENERATE OUTPUT "${_rti_profile_stamp}" CONTENT "${WIRELOOM_CPP_RTI_VERSION}\n")
    # Unchanged source files keep their timestamps; the first output records
    # successful generation even when none of the generated text changes.
    set(_generation_stamp "${_generated_dir}/generation.stamp")
    add_custom_command(
        OUTPUT "${_generation_stamp}" ${_outputs}
        COMMAND "${_tool}" generate "${_idl}" "${_generated_dir}" ${_generation_options}
        COMMAND "${CMAKE_COMMAND}" -E touch "${_generation_stamp}"
        DEPENDS "${_idl}" ${_include_inputs} "${_tool}" "${_rti_profile_stamp}"
        COMMENT "Generating Wireloom C++ sources for ${target}"
        VERBATIM)

    target_sources("${target}" PRIVATE "${_generation_stamp}" ${_outputs})
    target_include_directories("${target}" PRIVATE "${_generated_dir}")
    set_property(TARGET "${target}" PROPERTY WIRELOOM_GENERATED_DIR "${_generated_dir}")
    set_property(TARGET "${target}" PROPERTY WIRELOOM_GENERATED_OUTPUTS "${_outputs}")
endfunction()
