<Project>
  <ItemGroup>
    <AvailableItemName Include="WireloomIdl" />
    <ClCompile Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).cxx')" />
    <ClInclude Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).hpp')" />
    <ClCompile Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.cxx')" />
    <ClInclude Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.hpp')" />
  </ItemGroup>

  <UsingTask TaskName="WireloomDetectCppBuildHost" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <HostRid ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Runtime.InteropServices" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
            && RuntimeInformation.OSArchitecture == Architecture.X64)
        {
            HostRid = "win-x64";
        }
        else if (RuntimeInformation.IsOSPlatform(OSPlatform.Linux)
            && RuntimeInformation.OSArchitecture == Architecture.X64)
        {
            HostRid = "linux-x64";
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WireloomCppDetectBuildHost" Condition="'$(WireloomCppHostRid)' == '' and '@(WireloomIdl)' != ''">
    <WireloomDetectCppBuildHost>
      <Output TaskParameter="HostRid" PropertyName="WireloomCppHostRid" />
    </WireloomDetectCppBuildHost>
    <PropertyGroup>
      <WireloomCppToolName Condition="'$(WireloomCppHostRid)' == 'win-x64'">Wireloom.Dds.Cpp.exe</WireloomCppToolName>
      <WireloomCppToolName Condition="'$(WireloomCppHostRid)' == 'linux-x64'">Wireloom.Dds.Cpp</WireloomCppToolName>
      <WireloomCppTool Condition="'$(WireloomCppTool)' == '' and '$(WireloomCppHostRid)' != ''">$(WireloomCppPackageRoot)/tools/$(WireloomCppHostRid)/$(WireloomCppToolName)</WireloomCppTool>
    </PropertyGroup>
  </Target>

  <Target Name="WireloomCppValidateTool" BeforeTargets="WireloomCppGenerate" DependsOnTargets="WireloomCppDetectBuildHost" Condition="'@(WireloomIdl)' != ''">
    <Error Condition="'$(WireloomCppHostRid)' == '' and '$(WireloomCppTool)' == ''"
           Text="Wireloom C++ generation does not support this build host. Supported hosts are Windows x64 and Linux x64. Set WireloomCppTool to an executable for this host to override the packaged tool." />
    <Error Condition="!Exists('$(WireloomCppTool)')"
           Text="Wireloom C++ generator is missing at '$(WireloomCppTool)'. Restore the Wireloom.Dds.Cpp.Generator NuGet package or set WireloomCppTool to its host-native executable." />
  </Target>

  <Target Name="WireloomCppPrepareLinuxTool" BeforeTargets="WireloomCppValidateTool" DependsOnTargets="WireloomCppDetectBuildHost" Condition="'$(WireloomCppHostRid)' == 'linux-x64' and Exists('$(WireloomCppTool)')">
    <Exec Command="chmod +x &quot;$(WireloomCppTool)&quot;" />
  </Target>

  <Target Name="WireloomCppPrepareGeneration" DependsOnTargets="WireloomCppValidateTool" Condition="'@(WireloomIdl)' != ''">
    <PropertyGroup>
      <_WireloomCppStateDir>$(WireloomCppGeneratedDir)/.wireloom</_WireloomCppStateDir>
      <_WireloomCppCompletionStamp>$(_WireloomCppStateDir)/generation.stamp</_WireloomCppCompletionStamp>
      <_WireloomCppConfigurationStamp>$(_WireloomCppStateDir)/configuration.txt</_WireloomCppConfigurationStamp>
    </PropertyGroup>
    <ItemGroup>
      <_WireloomCppDependencyFile Include="@(WireloomIdl->'$(_WireloomCppStateDir)/%(Filename).deps')" />
      <_WireloomCppGeneratedFile Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).hpp');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).cxx');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.hpp');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.cxx')" />
      <_WireloomCppMissingFile Include="@(_WireloomCppDependencyFile);@(_WireloomCppGeneratedFile)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <MakeDir Directories="$(_WireloomCppStateDir)" />
    <WriteLinesToFile File="$(_WireloomCppConfigurationStamp)"
                      Lines="@(WireloomIdl->'%(FullPath)');$(WireloomCppTool);$(WireloomCppGeneratedDir);$(WireloomCppRtiVersion)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ReadLinesFromFile File="%(_WireloomCppDependencyFile.Identity)" Condition="Exists('%(_WireloomCppDependencyFile.Identity)')">
      <Output TaskParameter="Lines" ItemName="_WireloomCppDependency" />
    </ReadLinesFromFile>
    <!-- Generated text keeps its timestamp. Missing outputs must invalidate the
         completion stamp independently of timestamp comparisons. -->
    <Delete Files="$(_WireloomCppCompletionStamp)" Condition="'@(_WireloomCppMissingFile)' != ''" />
  </Target>

  <Target Name="WireloomCppGenerate"
          BeforeTargets="ClCompile"
          DependsOnTargets="WireloomCppPrepareGeneration"
          Condition="'@(WireloomIdl)' != ''"
          Inputs="@(WireloomIdl);@(_WireloomCppDependency);$(WireloomCppTool);$(_WireloomCppConfigurationStamp);$(MSBuildAllProjects);$(MSBuildProjectFullPath)"
          Outputs="$(_WireloomCppCompletionStamp)">
    <Delete Files="$(_WireloomCppCompletionStamp)" />
    <Exec Command="&quot;$(WireloomCppTool)&quot; generate &quot;%(WireloomIdl.FullPath)&quot; &quot;$(WireloomCppGeneratedDir)/.&quot; --rti-version &quot;$(WireloomCppRtiVersion)&quot; --dependency-file &quot;$(_WireloomCppStateDir)/%(WireloomIdl.Filename).deps&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false" />
    <Touch Files="$(_WireloomCppCompletionStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="WireloomCppTrackGeneratedFiles" BeforeTargets="ClCompile;Clean" Condition="'@(WireloomIdl)' != ''">
    <ItemGroup>
      <FileWrites Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).hpp')" />
      <FileWrites Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).cxx')" />
      <FileWrites Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.hpp')" />
      <FileWrites Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.cxx')" />
      <FileWrites Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/.wireloom/%(Filename).deps')" />
      <FileWrites Include="$(WireloomCppGeneratedDir)/.wireloom/generation.stamp;$(WireloomCppGeneratedDir)/.wireloom/configuration.txt" />
    </ItemGroup>
  </Target>

  <!-- Utility projects do not run the native compiler's FileWrites cleanup. -->
  <Target Name="WireloomCppClean" BeforeTargets="Clean" Condition="'@(WireloomIdl)' != '' or Exists('$(WireloomCppGeneratedDir)/.wireloom')">
    <ItemGroup>
      <_WireloomCppCleanDependency Include="$(WireloomCppGeneratedDir)/.wireloom/*.deps" />
      <_WireloomCppCleanFile Include="@(_WireloomCppCleanDependency->'$(WireloomCppGeneratedDir)/%(Filename).hpp');@(_WireloomCppCleanDependency->'$(WireloomCppGeneratedDir)/%(Filename).cxx');@(_WireloomCppCleanDependency->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.hpp');@(_WireloomCppCleanDependency->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.cxx')" />
      <_WireloomCppCleanFile Include="@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).hpp');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename).cxx');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.hpp');@(WireloomIdl->'$(WireloomCppGeneratedDir)/%(Filename)Plugin.cxx')" />
      <_WireloomCppCleanFile Include="$(WireloomCppGeneratedDir)/.wireloom/*.deps;$(WireloomCppGeneratedDir)/.wireloom/generation.stamp;$(WireloomCppGeneratedDir)/.wireloom/configuration.txt" />
    </ItemGroup>
    <Delete Files="@(_WireloomCppCleanFile)" />
  </Target>
</Project>
