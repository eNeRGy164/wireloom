<Project>
  <ItemGroup>
    <_DdsIdlProjectIncludeDirectory Include="$(DdsIdlIncludeDirectories)" />

    <_DdsIdlIncludeDirectory Include="@(_DdsIdlProjectIncludeDirectory)" />
    <_DdsIdlIncludeDirectory Include="@(DdsIdl->'%(IncludeDirectories)')" />
    <AdditionalFiles
      Include="$(DdsIdlIncludeDirectories)\**\*.idl"
      Exclude="@(DdsIdl);@(AdditionalFiles)"
      Condition="'$(DdsIdlIncludeDirectories)' != ''"
      Generate="false" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Generate" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="IncludeDirectories" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Defines" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Undefines" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Strict" />
    <AvailableItemName Include="DdsIdl" />
  </ItemGroup>

  <Target Name="WireloomPrepareIdlInputs" BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <ItemGroup>
      <!-- DdsIdl items are declared by the consumer project after package
           targets are evaluated, so mark matching AdditionalFiles items and
           add any missing generation roots at compile time. -->
      <AdditionalFiles Remove="@(DdsIdl);@(DdsIdl->'%(FullPath)')" />
      <AdditionalFiles
        Include="@(DdsIdl)"
        Generate="true">
        <IncludeDirectories>$([System.String]::Copy('$(DdsIdlIncludeDirectories)').Replace(';', '|'))|$([System.String]::Copy('%(DdsIdl.IncludeDirectories)').Replace(';', '|'))</IncludeDirectories>
        <Defines>%(DdsIdl.Defines)</Defines>
        <Undefines>%(DdsIdl.Undefines)</Undefines>
        <Strict>%(DdsIdl.Strict)</Strict>
      </AdditionalFiles>

      <AdditionalFiles
        Include="**/*.idl"
        Exclude="@(DdsIdl);@(DdsIdl->'%(FullPath)');@(AdditionalFiles);@(AdditionalFiles->'%(FullPath)')"
        Generate="false" />
      <AdditionalFiles
        Include="%(_DdsIdlProjectIncludeDirectory.FullPath)\**\*.idl"
        Exclude="@(DdsIdl);@(DdsIdl->'%(FullPath)');@(AdditionalFiles);@(AdditionalFiles->'%(FullPath)')"
        Condition="'$(DdsIdlIncludeDirectories)' != ''"
        Generate="false" />
    </ItemGroup>
  </Target>

  <Target Name="WireloomTrackPerRootIncludedIdl" BeforeTargets="GenerateMSBuildEditorConfigFileCore;CoreCompile">
    <ItemGroup>
      <_DdsIdlIncludedFile
        Include="%(_DdsIdlIncludeDirectory.FullPath)\**\*.idl"
        Condition="'%(_DdsIdlIncludeDirectory.FullPath)' != ''" />
      <AdditionalFiles
        Include="@(_DdsIdlIncludedFile)"
        Exclude="@(DdsIdl);@(DdsIdl->'%(FullPath)');@(AdditionalFiles);@(AdditionalFiles->'%(FullPath)')"
        Generate="false" />
    </ItemGroup>
  </Target>
</Project>
