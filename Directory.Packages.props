<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RtiConnextDdsVersion Condition="'$(RtiConnextDdsVersion)' == ''">7.7.0</RtiConnextDdsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Meziantou.Polyfill" Version="1.0.165" />
    <PackageVersion Include="JetBrains.Annotations.Sources" Version="2026.2.0" />
    <!-- Match the first .NET 8 C# 12 Roslyn host, the minimum supported consumer SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
    <PackageVersion Include="Rti.ConnextDds" Version="$(RtiConnextDdsVersion)" />
    <PackageVersion Include="Wireloom.Dds.Generator" Version="0.4.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
