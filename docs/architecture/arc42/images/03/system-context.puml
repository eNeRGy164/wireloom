@startuml
!include ../wireloom-theme.puml

actor ".NET DDS application\ndeveloper" as developer
actor "Build and CI\nengineer" as engineer
actor "Wireloom\nmaintainer" as maintainer
actor "Playground user" as user
rectangle "Wireloom" as wireloom <<product>>
rectangle ".NET build and IDE" as dotnet
rectangle "RTI Connext DDS\nruntime" as rti

developer --> wireloom : Drop-in compatibility;\nclean, extensible generated C#
engineer --> wireloom : Repeatable builds;\nminimal generation setup
maintainer --> wireloom : Testable changes;\nattributable compatibility evidence
user --> wireloom : Reliable local preview;\nno installation
wireloom <-- dotnet : Normal build integration;\nsource-located diagnostics
wireloom <-- rti : Compatible generated APIs\nand type-specific support

legend bottom
  Relationships express expectations of Wireloom
endlegend

@enduml
