@startuml

!include ../wireloom-theme.puml
!include sequence-style.puml

actor "Playground user" as user
participant "Editing and result\npresentation" as ui
participant "Workspace\nmanagement" as workspace
participant "Compilation request\ncoordination" as compilation

activate user

group Step 1: Stage the workspace change
  user -> ui ++ : Import / move / rename / delete /\nchange roles or settings
  ui -> ui : Stage candidate workspace change
  opt Import conflict or operation needs user choice
    ui --> user ++ : Conflict / destination / settings choice
    user -> ui -- : Confirm choice or cancel
  end
end

group Step 2: Validate the candidate
  opt Operation is not canceled
    ui -> workspace ++ : Validate candidate paths, roles,\nsettings, and structural bounds
  end
end

alt Canceled, undecodable, or invalid operation
  ui --> user : Preserve existing workspace and result
else Valid accepted change
  group Step 3: Apply the accepted workspace
    workspace --> ui -- : New workspace value with stable file identities
    ui -> ui : Synchronize editor models and selection
    note over ui : Moves preserve text and undo identities;\nconfigured include-folder paths follow folder moves
  end

  group Step 4: Refresh the preview
    ui -> compilation ++ : Invalidate/request current workspace preview
    ref over ui,compilation : Flow 3: Preview the current workspace
  end
end

@enduml
