@startuml

!include ../wireloom-theme.puml
!include sequence-style.puml

participant "Calling host\n.NET / browser / tests" as caller #F5F8F7
participant "Compilation\ncoordination" as coordination
participant "\nInput processing" as input
participant "\nLanguage analysis" as analysis
participant "\nC# code generation" as generation

activate caller

group Step 1: Capture compilation inputs
  caller -> coordination ++ : Inputs + profile + MD5 + cancellation
  coordination -> coordination : Snapshot inputs; establish compilation state
end

group Step 2: Process roots and includes
  loop Supplied generation roots
    coordination -> input ++ : Traverse supplied input graph
    loop Processed declarations and reachable includes
      input -> analysis -- : Parse callback: text, input, namespace, origins
    end
    note over input,analysis : Include traversal and macro/preprocessor state interact
  end
end

group Step 3: Bind and validate
  coordination -> analysis : Bind declarations / apply semantic validation
  coordination -> coordination : Check selected profile applicability
end

group Step 4: Generate C# documents
  coordination -> generation ++ : Profile/mapping plans and declaration generation
  generation --> coordination -- : Generated C# documents
end

group Step 5: Return the compilation result
  coordination --> caller -- : Combined documents and diagnostics
end

note over caller,generation
Expected IDL/applicability findings return diagnostics and no documents.
Accepted warnings can accompany generated documents.
Caller-contract errors, cancellation, and unexpected exceptions propagate.
Planning and rendering share implementation; no frozen-plan stage is implied.
end note

@enduml

