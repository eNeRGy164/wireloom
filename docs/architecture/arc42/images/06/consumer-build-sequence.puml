@startuml

!include ../wireloom-theme.puml
!include sequence-style.puml

actor ".NET DDS application\ndeveloper /\nBuild and CI engineer" as user
participant "\n.NET build / IDE" as host #F5F8F7
participant "MSBuild\nintegration" as msbuild
participant "\nRoslyn adapter" as adapter
participant "Shared IDL\ncompiler" as compiler

activate user

group Step 1: Evaluate project inputs
  user -> host ++ : Build / edit tracked inputs
  host -> msbuild ++ : Evaluate project IDL configuration
  msbuild --> host -- : Additional files and visible metadata
end

group Step 2: Supply tracked inputs
  host -> adapter ++ : Generator callback with inputs / references
end

alt No generation roots
  adapter --> host : No generation-specific work
else Generation roots present
  group Step 3: Check host and select profile
    adapter -> adapter : Check language, RTI reference,\nand host settings; select profile
  end

  alt Host/configuration check fails
    adapter --> host : Host/configuration diagnostic
  else Applicable inputs
    group Step 4: Compile the IDL batch
      adapter -> compiler ++ : Compile(inputs, profile, MD5, cancellation)
      ref over compiler : C1: Compile an in-memory IDL batch
      compiler --> adapter -- : Documents and diagnostics
    end
  end
end

group Step 5: Report the build or IDE result
  opt Compiler result is available
    adapter -> host -- : Report diagnostics; register documents\nonly for a successful result
  end
  host --> user -- : Build/IDE result and diagnostics
end

note over user,host
Root/include/settings/RTI-reference changes are variants.
Cancellation remains cancellation, not a successful partial result.
end note

@enduml
