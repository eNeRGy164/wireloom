@startuml

!include ../wireloom-theme.puml
!include sequence-style.puml

actor "Playground user" as user
participant "Editing and result\npresentation" as ui
participant "Workspace\nmanagement" as workspace
participant "Browser file /\nclipboard APIs" as browser #F5F8F7

activate user

group Step 1: Choose the export
  user -> ui ++ : Copy / download / ZIP
end

alt Source or source-workspace backup
  group Step 2: Prepare source export
    ui -> workspace ++ : Obtain current source/settings snapshot
    workspace --> ui -- : Source files, folders, and metadata
  end
else Generated output requested
  group Step 3: Prepare generated export
    alt Accepted current successful result has documents
      ui -> ui : Take accepted document names/text
    else Output is stale, pending, failed, or empty
      ui --> user : Generated export unavailable
    end
  end
end

group Step 4: Deliver the export
  opt Export is available
    ui -> browser ++ : Copy text / download source, source ZIP,\nor current generated output
    browser --> user -- : Local artifact / clipboard content
  end
end

note over ui,workspace
Source backup is independent of compilation success.
end note

@enduml

