@startuml

!include ../wireloom-theme.puml
!include legend.puml

rectangle "Compilation coordination" as coordination <<neighbor>>
rectangle "Input processing" as input <<neighbor>>
rectangle "C# code generation" as generation <<neighbor>>
rectangle "Language analysis" as analysis <<whitebox>> {
  rectangle "Parsing" as parsing <<blackbox>>
  rectangle "Binding" as binding <<blackbox>>
  rectangle "Semantic validation" as validation <<blackbox>>

  parsing -- binding : Shared declarations / symbols
  binding -- validation : Shared semantic model
}

coordination .> parsing : Declaration analysis facade
coordination .> binding : Binding facade
coordination .> validation : Validation policy interface
input -right- parsing : Source text / origin contract
generation -right- binding : Bound declarations / type facts

@enduml

