@startuml
title Wire compatibility applications and evidence flow
skinparam componentStyle rectangle
left to right direction

component "GitHub Actions\nversion and shard matrix" as workflow
component "Licensed RTI Docker\nRunner" as runner
component "Shared\ncontracts" as shared
component "Managed and native\npeer builds" as peers
component "Domain-isolated\nwire exchanges" as exchanges
artifact "Shard evidence\nplan, outcomes, logs" as shards
component "License-free\nVerifier" as verifier
artifact "Combined report\nand workflow summary" as report

database "Corpus, profiles,\nand RTI oracles" as corpus

workflow --> runner
runner --> shared
runner --> corpus
runner --> peers
peers --> exchanges
exchanges --> shards
runner --> shards : partial evidence on failure
workflow --> verifier : download shard artifacts
verifier --> shards : validate completeness
verifier --> report : merge
workflow --> report : publish summary
@enduml
