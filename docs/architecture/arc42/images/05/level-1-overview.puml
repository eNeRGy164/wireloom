@startuml

!include ../wireloom-theme.puml
!include legend.puml

rectangle ".NET build and IDE" as dotnet <<neighbor>>
actor "Build and CI\nengineer" as engineer
actor "Wireloom maintainer" as maintainer
actor ".NET DDS application\ndeveloper" as developer
rectangle "RTI Connext DDS\nruntime contract" as rti <<neighbor>>
rectangle "Supporting verification\ntooling" as verification <<neighbor>>
rectangle "Wireloom" as product <<whitebox>> {
  rectangle ".NET build\nintegration" as integration <<blackbox>>
  rectangle "Playground" as playground <<blackbox>>
  rectangle "Shared IDL\ncompiler" as compiler <<blackbox>>
  integration ..> compiler : Compiler contract
  playground .> compiler
}
actor "Playground user" as user
developer -- integration : Project configuration interface
engineer -- integration : Build configuration interface
maintainer -left- verification : Verification entry points
verification .up.> product : Product interfaces
dotnet -- integration : MSBuild / Roslyn contracts
rti .up. compiler : Generated-code target contract
playground -left- user : Local workspace interface

@enduml
