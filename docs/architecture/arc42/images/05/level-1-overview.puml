@startuml
skinparam componentStyle rectangle

rectangle "Consumer project" as consumer
rectangle "MSBuild targets\nDdsIdl + include metadata" as msbuild
rectangle "Roslyn adapter\nGenerator + runtime discovery" as generator
rectangle "Repository compiler host\ncurrent tests and tools" as host
package "Wireloom.Dds.Compiler" as compiler {
  rectangle "Public API\nIdlCompiler.Compile(inputs, profile)" as api
  rectangle "Compilation pipeline\npreprocess, parse, bind, validate" as pipeline
  rectangle "Emitters\nmanaged/native/type support" as emitters
}
rectangle "Generated C#\nAdditional documents" as output
rectangle "RTI Connext DDS\nruntime" as runtime
database "IDL corpus + RTI oracles" as corpus

consumer --> msbuild : declares roots
msbuild --> generator : AdditionalFiles
generator --> api : in-memory inputs + mapped profile
host --> api : in-memory inputs + explicit profile
api --> pipeline : input snapshot
pipeline --> emitters
emitters --> api : documents + diagnostics
api --> generator : combined result
api --> host : combined result
generator --> output : AddSource
output --> consumer : compile-time types
consumer --> runtime : explicit reference
corpus --> pipeline : compliance cases
@enduml
