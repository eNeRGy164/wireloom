@startuml
component "IDL source" as source
component "IdlSyntaxReader\nordered raw applications" as syntax
component "IdlAnnotationCatalog\nknown / opaque boundary" as catalog
component "Context parsers\ndeclaration, type, member, enum, union" as parsers
component "IdlParseContext\ndependency-aware phases" as context
component "IdlValueBinder" as binder
component "IdlValueResolver\ntyped scalar values" as resolver
component "Semantic model and diagnostics" as output

source --> syntax : annotation text + offsets
syntax --> catalog : name + balanced arguments
catalog --> parsers : known applications
catalog --> output : unknown apps stay opaque
parsers --> context : unresolved expressions + locations
context --> binder : complete symbol graph
binder --> resolver : typed values + constraints
resolver --> output : bound values / source errors
@enduml
