@startuml
title Implemented native and future browser MD5 delegate boundary (ADR-002 Accepted)
skinparam componentStyle rectangle

package "Desktop build host" {
  rectangle "Wireloom.Dds.Generator\nRoslyn adapter (netstandard2.0)\n\nReads inputs and maps RTI profile\nSupplies BCL MD5 lambda\nReports diagnostics and adds sources" as roslyn
}

package "Future browser host (net10.0 / browser-wasm)" {
  rectangle "JavaScript editor / UI" as ui
  rectangle "Browser .NET adapter\nJSExport or Blazor entry point\nSupplies browser-compatible MD5 delegate\nConverts compilation requests and results" as browser
  ui <--> browser : compilation request / result
}

package "Wireloom.Dds.Compiler (netstandard2.0)\nSame implementation on both hosts" {
  rectangle "IdlCompiler.Compile\ninputs + profile + computeMd5 + cancellation" as api
  rectangle "Compiler pipeline\npreprocess / parse / bind / validate\nplan / render generated sources" as pipeline
  rectangle "IdlMemberIdHash\nUTF-8 + supplied MD5 delegate\n16-byte digest validation\nlittle-endian + 28-bit mask" as hash
}

roslyn <--> api : inputs + profile + native MD5 delegate /\ndocuments + diagnostics
browser <--> api : inputs + profile + browser MD5 delegate /\ndocuments + diagnostics
api --> pipeline
pipeline --> hash : member identity

note bottom of hash
  Protocol semantics stay in the core.
  The host owns digest production.
  The delegate is supplied per compilation.
  Native provider is implemented; browser provider is future work.
end note

@enduml
