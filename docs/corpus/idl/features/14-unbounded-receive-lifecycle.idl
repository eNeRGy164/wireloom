module CorpusUnboundedReceiveLifecycle {
    typedef sequence<long> LongValues;

    struct OptionalState {
        long value;
        @optional string note;
        sequence<string> labels;
    };

    struct Sample {
        long phaseId;
        sequence<long> values;
        string text;
        wstring wideText;
        sequence<string> labels;
        LongValues aliasValues;
        sequence<long, 4> boundedValues;
        string<8> boundedText;
        @optional OptionalState optionalState;
    };
};
