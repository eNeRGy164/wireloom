# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temp files
*.log
*.tmp
*.temp

# Retain oracle diagnostics for negative cases with no generated source.
!/docs/corpus/*/rtiddsgen/*/negative/*/rtiddsgen.log

# Secrets and local environment files
.env
.env.*
!.env.example

# dotnet development
bin/
obj/
*.user
*.suo

# Visual Studio
*.vs/

# Stryker
StrykerOutput/
.stryker/

# Qodana
.qodana/

# project
package-test-feed/
/\.playwright-cli/
coverage/
playground/node_modules/
playground/dist/
playground/dist-subpath/
playground/dist-pages/
playground/dist-coverage/
playground/public/dotnet/
output/playwright/

# Local wire-compatibility run reports and sanitized logs
artifacts/
tmp/

# Capture/export run reports belong in artifacts, not retained corpus sources.
/docs/corpus/*/generator/export-evidence-*.json
/docs/corpus/*/generator/export-sdk-*.txt
/docs/corpus/*/generator/export-tests-*.txt
/docs/corpus/7.7.0/generator/csharp/export-evidence-*.json
/docs/corpus/7.7.0/generator/csharp/export-sdk-*.txt
/docs/corpus/7.7.0/generator/csharp/export-tests-*.txt
/docs/corpus/*/rtiddsgen/capture-*.json
/docs/corpus/*/rtiddsgen/toolchain-*.txt
