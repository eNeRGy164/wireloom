# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temp files
*.log
*.tmp
*.temp

# Retain the focused strict-validation oracle diagnostics with their sources.
!/docs/corpus/*/rtiddsgen/*/negative/12-keyword-*/rtiddsgen.log
!/docs/corpus/*/rtiddsgen/*/negative/12-case-collision-*/rtiddsgen.log
!/docs/corpus/*/rtiddsgen/*/negative/12-exact-keyword/rtiddsgen.log
!/docs/corpus/*/rtiddsgen/*/negative/12-identifier-control/rtiddsgen.log
!/docs/corpus/*/rtiddsgen/*/negative/12-derived-key-strict/rtiddsgen.log

!/docs/corpus/*/rtiddsgen/*/negative/12-interface-*/rtiddsgen.log

# Secrets and local environment files
.env
.env.*
!.env.example

# dotnet development
bin/
obj/
*.user
*.suo

# Visual Studio
*.vs/

# Stryker
StrykerOutput/
.stryker/

# Qodana
.qodana/

# project
package-test-feed/
coverage/

# Local wire-compatibility run reports and sanitized logs
artifacts/
tmp/

# Capture/export run reports belong in artifacts, not retained corpus sources.
/docs/corpus/*/generator/export-evidence-*.json
/docs/corpus/*/generator/export-sdk-*.txt
/docs/corpus/*/generator/export-tests-*.txt
/docs/corpus/*/rtiddsgen/capture-*.json
/docs/corpus/*/rtiddsgen/toolchain-*.txt
